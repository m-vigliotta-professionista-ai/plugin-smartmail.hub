    function pad2(value) {
        return String(value).padStart(2, '0');
    }

    function parseDateOnly(value) {
        if (!value) {
            const now = new Date();
            return new Date(now.getFullYear(), now.getMonth(), now.getDate());
        }

        const parts = String(value).split('-').map((part) => Number(part));
        return new Date(parts[0], (parts[1] || 1) - 1, parts[2] || 1);
    }

    function formatDateOnly(value) {
        const date = value instanceof Date ? value : parseDateOnly(value);
        return `${date.getFullYear()}-${pad2(date.getMonth() + 1)}-${pad2(date.getDate())}`;
    }

    function cloneDate(value) {
        return new Date(value.getFullYear(), value.getMonth(), value.getDate());
    }

    function parseDateTimeValue(value) {
        if (!value) {
            return new Date();
        }

        return new Date(String(value).replace(' ', 'T'));
    }

    function addDays(value, amount) {
        const date = cloneDate(value);
        date.setDate(date.getDate() + amount);
        return date;
    }

    function startOfWeek(value) {
        const date = cloneDate(value);
        const dayIndex = (date.getDay() + 6) % 7;
        date.setDate(date.getDate() - dayIndex);
        return date;
    }

    function endOfWeek(value) {
        return addDays(startOfWeek(value), 6);
    }

    function startOfMonth(value) {
        return new Date(value.getFullYear(), value.getMonth(), 1);
    }

    function endOfMonth(value) {
        return new Date(value.getFullYear(), value.getMonth() + 1, 0);
    }

    function startOfMonthGrid(value) {
        return startOfWeek(startOfMonth(value));
    }

    function endOfMonthGrid(value) {
        return addDays(startOfWeek(endOfMonth(value)), 6);
    }

    function sameDay(first, second) {
        return Boolean(first && second)
            && first.getFullYear() === second.getFullYear()
            && first.getMonth() === second.getMonth()
            && first.getDate() === second.getDate();
    }

    function calendarCurrentDate() {
        if (!state.calendarCursor) {
            state.calendarCursor = formatDateOnly(new Date());
        }

        return parseDateOnly(state.calendarCursor);
    }

    function currentCalendarRange() {
        const current = calendarCurrentDate();

        if (state.calendarView === 'day') {
            return {
                startDate: current,
                endDate: current
            };
        }

        if (state.calendarView === 'month') {
            return {
                startDate: startOfMonthGrid(current),
                endDate: endOfMonthGrid(current)
            };
        }

        if (state.calendarView === 'agenda') {
            return {
                startDate: current,
                endDate: addDays(current, 29)
            };
        }

        return {
            startDate: startOfWeek(current),
            endDate: endOfWeek(current)
        };
    }

    function syncCalendarRangeFields() {
        const range = currentCalendarRange();
        const startInput = region('calendar-start');
        const endInput = region('calendar-end');

        if (startInput) {
            startInput.value = formatDateOnly(range.startDate);
        }
        if (endInput) {
            endInput.value = formatDateOnly(range.endDate);
        }
    }

    function calendarSearchQuery() {
        return String(region('calendar-search') ? region('calendar-search').value : '').trim().toLowerCase();
    }

    function calendarFilterQuery() {
        return String(region('calendar-filter') ? region('calendar-filter').value : '').trim().toLowerCase();
    }

    function filteredCalendarEvents() {
        const query = calendarSearchQuery();
        if (!query) {
            return [...state.calendarEvents];
        }

        return state.calendarEvents.filter((calendarEvent) => {
            const haystack = [
                calendarEvent.title,
                calendarEvent.location,
                calendarEvent.description,
                calendarEvent.calendar_name,
                (calendarEvent.attendees || []).map((attendee) => attendee.name || attendee.email).join(' ')
            ].join(' ').toLowerCase();

            return haystack.includes(query);
        });
    }

    function calendarEventKey(calendarEvent) {
        return calendarEvent.occurrence_key || `event-${calendarEvent.id}`;
    }

    function calendarEventColor(calendarEvent) {
        const owner = state.calendars.find((calendar) => Number(calendar.id) === Number(calendarEvent.calendar_id));
        return owner && owner.color ? owner.color : '#0d5c63';
    }

    function calendarDateRange(startDate, endDate) {
        const items = [];
        for (let cursor = cloneDate(startDate); cursor <= endDate; cursor = addDays(cursor, 1)) {
            items.push(cloneDate(cursor));
        }
        return items;
    }

    function calendarHourLabel(hour) {
        return `${pad2(hour)}:00`;
    }

    function filteredCalendars() {
        const query = calendarFilterQuery();
        if (!query) {
            return [...state.calendars];
        }

        return state.calendars.filter((calendar) => [calendar.name, calendar.owner_name, calendar.description].join(' ').toLowerCase().includes(query));
    }

    function highlightCalendarEventSelection(eventKey) {
        app.querySelectorAll('[data-event-key]').forEach((element) => {
            element.classList.toggle('is-active', String(element.getAttribute('data-event-key')) === String(eventKey));
        });
    }

    function updateCalendarViewButtons() {
        app.querySelectorAll('[data-action="switch-calendar-view"]').forEach((button) => {
            button.classList.toggle('is-active', button.getAttribute('data-view') === state.calendarView);
        });
    }

    function formatCalendarDayLabel(value, options = {}) {
        return value.toLocaleDateString('it-IT', {
            weekday: options.longWeekday ? 'long' : 'short',
            day: 'numeric',
            month: options.longMonth ? 'long' : 'short'
        });
    }

    function updateCalendarPeriod() {
        const range = currentCalendarRange();
        const titleTarget = region('calendar-period-label');
        const subtitleTarget = region('calendar-period-subtitle');

        let label = '';
        if (state.calendarView === 'day') {
            label = calendarCurrentDate().toLocaleDateString('it-IT', {
                weekday: 'long',
                day: 'numeric',
                month: 'long',
                year: 'numeric'
            });
        } else if (state.calendarView === 'month') {
            label = calendarCurrentDate().toLocaleDateString('it-IT', {
                month: 'long',
                year: 'numeric'
            });
        } else if (state.calendarView === 'agenda') {
            label = `Agenda ${range.startDate.toLocaleDateString('it-IT', { day: 'numeric', month: 'long' })} - ${range.endDate.toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' })}`;
        } else {
            label = `${range.startDate.toLocaleDateString('it-IT', { day: 'numeric', month: 'long' })} - ${range.endDate.toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' })}`;
        }

        if (titleTarget) {
            titleTarget.textContent = label.charAt(0).toUpperCase() + label.slice(1);
        }
        if (subtitleTarget) {
            subtitleTarget.textContent = `Vista ${state.calendarView} | ${escapeHtml((eventField('timezone') && eventField('timezone').value) || 'Europe/Rome')}`;
        }
    }

    function renderMiniMonth() {
        const target = region('calendar-mini-month');
        const labelTarget = region('calendar-mini-label');

        if (!target) {
            return;
        }

        const current = calendarCurrentDate();
        const gridStart = startOfMonthGrid(current);
        const gridEnd = endOfMonthGrid(current);
        const today = parseDateOnly(formatDateOnly(new Date()));
        const selectedRange = currentCalendarRange();
        const cells = [];

        for (let cursor = cloneDate(gridStart); cursor <= gridEnd; cursor = addDays(cursor, 1)) {
            const inCurrentMonth = cursor.getMonth() === current.getMonth();
            const inRange = cursor >= selectedRange.startDate && cursor <= selectedRange.endDate;
            const classNames = [
                'v24-smh-calendar-mini-day',
                inCurrentMonth ? '' : 'is-outside',
                sameDay(cursor, today) ? 'is-today' : '',
                inRange ? 'is-range' : ''
            ].filter(Boolean).join(' ');

            cells.push(`
                <button type="button" class="${classNames}" data-action="calendar-mini-day" data-date="${formatDateOnly(cursor)}">
                    ${cursor.getDate()}
                </button>
            `);
        }

        if (labelTarget) {
            labelTarget.textContent = current.toLocaleDateString('it-IT', { month: 'long', year: 'numeric' });
        }

        target.innerHTML = `
            <div class="v24-smh-calendar-mini-weekdays">
                <span>Lun</span>
                <span>Mar</span>
                <span>Mer</span>
                <span>Gio</span>
                <span>Ven</span>
                <span>Sab</span>
                <span>Dom</span>
            </div>
            <div class="v24-smh-calendar-mini-grid">
                ${cells.join('')}
            </div>
        `;
    }

    function setActiveModule(module) {
        state.module = module;

        app.querySelectorAll('[data-module-panel]').forEach((panel) => {
            panel.hidden = panel.getAttribute('data-module-panel') !== module;
        });

        app.querySelectorAll('[data-module]').forEach((button) => {
            button.classList.toggle('is-active', button.getAttribute('data-module') === module);
        });

        if (module === 'contacts') {
            loadContacts().catch((error) => setStatus(error.message || 'Caricamento contatti non riuscito.'));
            return;
        }

        if (module === 'calendar') {
            Promise.all([loadWorkspaceUsers(), loadCalendars()]).then(() => {
                ensureCalendarRange();
                updateCalendarViewButtons();
                updateCalendarPeriod();
                renderMiniMonth();
                return loadEvents();
            }).catch((error) => setStatus(error.message || 'Caricamento calendario non riuscito.'));
            return;
        }

        if (module === 'tasks') {
            Promise.all([loadWorkspaceUsers(), loadTasks()]).catch((error) => setStatus(error.message || 'Caricamento task non riuscito.'));
            return;
        }

        if (module === 'rules') {
            loadRulesContext().catch((error) => setStatus(error.message || 'Caricamento regole non riuscito.'));
        }
    }

    async function loadAccounts() {
        setStatus('Caricamento account...');
        const result = await api('/accounts');
        const accounts = result.data || [];
        state.accounts = accounts;
        renderAccounts();
        populateRulesAccountSelect();

        if (accounts[0]) {
            state.rulesAccountId = state.rulesAccountId || accounts[0].id;
            const requestedAccount = accounts.find((account) => Number(account.id) === Number(state.initialAccountId));
            await selectAccount(requestedAccount ? requestedAccount.id : accounts[0].id);
        } else {
            setStatus('Nessun account disponibile.');
        }
    }

    function renderAccounts() {
        const target = region('accounts');
        target.innerHTML = '';

        state.accounts.forEach((account) => {
            const primaryLabel = account.display_name || account.label || account.email_address || 'Account';
            const secondaryLabel = account.email_address && account.email_address !== primaryLabel ? account.email_address : '';
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'v24-smh-list-button v24-smh-account-button';
            button.setAttribute('data-account-id', account.id);
            button.innerHTML = `
                <strong>${escapeHtml(primaryLabel)}</strong>
                ${secondaryLabel ? `<small>${escapeHtml(secondaryLabel)}</small>` : ''}
            `;
            button.addEventListener('click', () => selectAccount(account.id));
            target.appendChild(button);
        });

        highlightSelection(target, 'data-account-id', state.accountId);
    }

    function populateRulesAccountSelect() {
        const target = region('rules-account');
        if (!target) {
            return;
        }

        target.innerHTML = '';
        state.accounts.forEach((account) => {
            target.appendChild(createOption(account.id, account.label || account.email_address, Number(account.id) === Number(state.rulesAccountId)));
        });
    }

    async function selectAccount(id) {
        state.accountId = id;
        state.folders = [];
        state.folderId = null;
        state.messages = [];
        state.currentMessage = null;
        state.folderContextId = null;
        state.messageContextId = null;
        dispatchBridgeEvent('v24-smh-account-selected', { accountId: id });
        highlightSelection(region('accounts'), 'data-account-id', id);
        renderAccounts();
        setStatus('Caricamento cartelle...');

        const result = await api(`/mail/folders?account_id=${id}`);
        state.folders = result.data || [];
        renderFolders();

        const requestedFolderId = Number(state.initialAccountId) === Number(id) ? Number(state.initialFolderId || 0) : 0;
        const requestedFolder = requestedFolderId ? state.folders.find((folder) => Number(folder.id) === requestedFolderId) : null;
        state.initialAccountId = 0;
        state.initialFolderId = 0;

        const preferredFolder = requestedFolder || resolvePreferredFolder(state.folders);
        if (preferredFolder) {
            await selectFolder(preferredFolder.id);
        } else {
            updateMailListHeader(0);
            region('messages').innerHTML = '<p>Nessuna cartella sincronizzata.</p>';
            region('reader').innerHTML = '<p>Avvia una sincronizzazione per popolare le cartelle.</p>';
            syncFolderRoute();
            setStatus('Account pronto.');
        }

        if (!state.rulesAccountId) {
            state.rulesAccountId = id;
            populateRulesAccountSelect();
        }
    }

    function renderFolders() {
        const target = region('folders');
        const favoriteIds = new Set(readFolderPrefs(state.accountId, state.folders).favorites.map((id) => Number(id)));
        target.innerHTML = '';

        foldersForDisplay(state.folders).forEach((folder) => {
            const button = document.createElement('button');
            const secondaryLabel = folderSecondaryLabel(folder);
            button.type = 'button';
            button.className = 'v24-smh-list-button v24-smh-folder-button';
            button.setAttribute('data-folder-id', folder.id);
            button.style.setProperty('--v24-folder-indent', `${folderDepth(folder) * 18}px`);
            button.innerHTML = `
                <span class="v24-smh-folder-button-row">
                    <strong>${escapeHtml(folderListLabel(folder))}</strong>
                    ${favoriteIds.has(Number(folder.id)) ? '<span class="v24-smh-folder-favorite" aria-hidden="true">&#9733;</span>' : ''}
                </span>
                ${secondaryLabel ? `<small>${escapeHtml(secondaryLabel)}</small>` : ''}
            `;
            button.classList.toggle('is-favorite', favoriteIds.has(Number(folder.id)));
            button.addEventListener('click', () => selectFolder(folder.id));
            button.addEventListener('contextmenu', (event) => {
                event.preventDefault();
                showFolderContextMenu(folder, event.clientX, event.clientY);
            });
            button.addEventListener('keydown', (event) => {
                if (event.key === 'ContextMenu' || (event.shiftKey && event.key === 'F10')) {
                    event.preventDefault();
                    const rect = button.getBoundingClientRect();
                    showFolderContextMenu(folder, rect.left + 20, rect.top + Math.min(rect.height, 48));
                }
            });
            target.appendChild(button);
        });

        highlightSelection(target, 'data-folder-id', state.folderId);
        updateFolderContextHighlight();
    }

    async function selectFolder(id) {
        state.folderId = id;
        state.messages = [];
        state.currentMessage = null;
        closeFolderContextMenu();
        closeMessageContextMenu();
        dispatchBridgeEvent('v24-smh-folder-selected', { accountId: state.accountId, folderId: id });
        syncFolderRoute();
        renderFolders();
        await loadMessages();
    }

    function moveFolderOrder(folderId, direction) {
        const folder = folderById(folderId);
        const parentKey = folderParentKey(folder);
        const ids = orderedFolderSiblings(parentKey).map((item) => Number(item.id));
        const currentIndex = ids.indexOf(Number(folderId));
        const targetIndex = currentIndex + direction;
        if (currentIndex < 0 || targetIndex < 0 || targetIndex >= ids.length) {
            return false;
        }

        const targetFolder = folderById(ids[targetIndex]);
        const currentFolderItem = folder;
        if (isInboxFolder(currentFolderItem) || isInboxFolder(targetFolder)) {
            return false;
        }

        [ids[currentIndex], ids[targetIndex]] = [ids[targetIndex], ids[currentIndex]];
        const prefs = readFolderPrefs(state.accountId, state.folders);
        prefs.orderMap[parentKey] = ids;
        writeFolderPrefs(state.accountId, prefs, state.folders);
        renderFolders();
        return true;
    }

    async function createFolderFromContext(folder) {
        const name = await openFolderTextDialog({
            title: 'Nuova cartella',
            description: `Crea una sottocartella dentro ${folderDisplayName(folder)}.`,
            label: 'Nome cartella',
            confirmLabel: 'Crea',
            value: ''
        });
        if (!name) {
            return;
        }

        setStatus('Creazione cartella...');
        const result = await api('/mail/folders/create', {
            method: 'POST',
            body: JSON.stringify({
                account_id: state.accountId,
                parent_folder_id: Number(folder.id),
                name: name.trim()
            })
        });

        state.folders = result.data && result.data.folders ? result.data.folders : state.folders;
        renderFolders();

        if (result.data && result.data.folder && result.data.folder.id) {
            await selectFolder(result.data.folder.id);
        } else {
            setStatus('Cartella creata.');
        }
    }

    async function renameFolderFromContext(folder) {
        const name = await openFolderTextDialog({
            title: 'Rinomina cartella',
            description: `Nuovo nome per ${folderDisplayName(folder)}.`,
            label: 'Nome cartella',
            confirmLabel: 'Salva',
            value: folderBaseName(folder)
        });
        if (!name) {
            return;
        }

        setStatus('Rinomina cartella...');
        const result = await api(`/mail/folders/${folder.id}/rename`, {
            method: 'POST',
            body: JSON.stringify({ name: name.trim() })
        });

        if (result.data && result.data.folder) {
            state.folders = state.folders.map((item) => (Number(item.id) === Number(folder.id) ? result.data.folder : item));
            renderFolders();
            if (Number(state.folderId) === Number(folder.id)) {
                await loadMessages();
            }
        }

        setStatus('Cartella rinominata.');
    }


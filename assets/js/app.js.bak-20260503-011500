    function openCompose(mode) {
        state.composeMode = mode || 'new';
        const compose = region('compose');
        const title = region('compose-title');
        const current = state.currentMessage;

        compose.querySelector('form').reset();
        setComposeBodyHtml('');
        composeWrapper('to').hidden = false;
        composeWrapper('cc').hidden = false;
        composeWrapper('bcc').hidden = false;

        if (mode === 'reply' || mode === 'reply_all') {
            title.textContent = mode === 'reply_all' ? 'Rispondi a tutti' : 'Rispondi';
            composeField('subject').value = current ? `Re: ${current.subject || ''}` : '';
            composeWrapper('to').hidden = true;
            composeWrapper('cc').hidden = true;
            composeWrapper('bcc').hidden = true;
        } else if (mode === 'forward') {
            title.textContent = 'Inoltra messaggio';
            composeField('subject').value = current ? `Fwd: ${current.subject || ''}` : '';
        } else {
            title.textContent = 'Nuova email';
        }

        renderComposeContext(current, mode);
        compose.hidden = false;
        syncComposeBody();
        composeEditor().focus();
        dispatchBridgeEvent('v24-smh-compose-opened', {
            accountId: state.accountId,
            composeMode: state.composeMode,
            message: current || null
        });
    }

    function openComposeTo(email) {
        setActiveModule('mail');
        openCompose('new');
        composeField('to').value = email || '';
    }

    async function submitCompose(event) {
        event.preventDefault();
        if (!state.accountId) {
            setStatus('Seleziona prima un account.');
            return;
        }

        syncComposeBody();
        const form = new FormData(event.target);
        const payload = {
            account_id: state.accountId,
            to: splitAddresses(form.get('to')),
            cc: splitAddresses(form.get('cc')),
            bcc: splitAddresses(form.get('bcc')),
            subject: form.get('subject') || '',
            body: form.get('body') || '',
            body_format: 'html'
        };

        setStatus('Invio in corso...');

        if (state.composeMode === 'reply' || state.composeMode === 'reply_all') {
            await api(`/mail/messages/${state.currentMessage.id}/reply`, {
                method: 'POST',
                body: JSON.stringify({
                    reply_all: state.composeMode === 'reply_all',
                    body: payload.body,
                    body_format: 'html'
                })
            });
        } else if (state.composeMode === 'forward') {
            await api(`/mail/messages/${state.currentMessage.id}/forward`, {
                method: 'POST',
                body: JSON.stringify({
                    to: payload.to,
                    cc: payload.cc,
                    bcc: payload.bcc,
                    body: payload.body
                })
            });
        } else {
            await api('/mail/send', {
                method: 'POST',
                body: JSON.stringify(payload)
            });
        }

        closeCompose();
        setStatus('Email inviata.');
    }

    async function sync() {
        if (!state.accountId) {
            return;
        }

        const previousFolderId = state.folderId;

        setStatus('Sincronizzazione in corso...');
        await api(`/accounts/${state.accountId}/sync`, { method: 'POST', body: '{}' });
        await selectAccount(state.accountId);

        if (previousFolderId && state.folders.some((folder) => Number(folder.id) === Number(previousFolderId))) {
            await selectFolder(previousFolderId);
        }

        setStatus('Sincronizzazione completata.');
    }


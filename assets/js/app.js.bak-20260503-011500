        const extraEmails = safeJson(contact.emails_json).filter((email) => email !== contact.primary_email);
        const extraPhones = safeJson(contact.phones_json).filter((phone) => phone !== contact.mobile_phone && phone !== contact.business_phone);
        const addresses = safeJson(contact.addresses_json);
        const categories = safeJson(contact.categories_json);
        const groups = contactGroupsFor(contact).map((group) => group.label);
        const summary = [contact.company, contact.department, contact.job_title].filter(Boolean).join(' | ') || 'Scheda contatto pronta per email, calendario e task.';

        const renderRow = (label, value) => `

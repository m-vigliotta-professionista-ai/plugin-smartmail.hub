(function () {
    const app = document.querySelector('[data-v24-smh-app]');
    const config = window.V24SMH || {
        root: app ? app.dataset.restRoot : '',
        nonce: app ? app.dataset.restNonce : ''
    };
    const currentUserId = Number(app.dataset.currentUserId || 0);
    const initialRoute = new URLSearchParams(window.location.search);

    if (!app || !config.root || !config.nonce) {
        return;
    }

    const state = {
        module: 'mail',
        accounts: [],
        accountId: null,
        folders: [],
        folderId: null,
        messages: [],
        messageContextId: null,
        currentMessage: null,
        currentContact: null,
        contacts: [],
        contactGroup: 'all',
        currentCalendar: null,
        currentEvent: null,
        currentTask: null,
        currentRule: null,
        calendars: [],
        selectedCalendarId: null,
        calendarEvents: [],
        calendarView: 'week',
        calendarCursor: '',
        users: [],
        rulesAccountId: null,
        ruleFolders: [],
        composeMode: 'new',
        editingContactId: null,
        editingCalendarId: null,
        editingEventId: null,
        editingTaskId: null,
        editingRuleId: null,
        eventEditMode: 'series',
        initialAccountId: Number(initialRoute.get('smh_account') || 0),
        initialFolderId: Number(initialRoute.get('smh_folder') || 0),
        folderContextId: null
    };
    const ROOT_FOLDER_GROUP = '__root__';
    const folderDialogState = {
        resolver: null
    };

    const apiRoot = config.root.replace(/\/$/, '');
    const region = (name) => app.querySelector(`[data-region="${name}"]`);
    const composeField = (name) => app.querySelector(`[data-field="${name}"]`);
    const composeWrapper = (name) => app.querySelector(`[data-compose-field="${name}"]`);
    const composeEditor = () => composeField('body-editor');
    const contactField = (name) => app.querySelector(`[data-field="contact-${name}"]`);
    const calendarField = (name) => app.querySelector(`[data-field="calendar-${name}"]`);
    const eventField = (name) => app.querySelector(`[data-field="event-${name}"]`);
    const taskField = (name) => app.querySelector(`[data-field="task-${name}"]`);
    const ruleField = (name) => app.querySelector(`[data-field="rule-${name}"]`);

    const api = async (path, options = {}) => {
        const response = await fetch(apiRoot + path, {
            ...options,
            headers: {
                'Content-Type': 'application/json',
                'X-WP-Nonce': config.nonce,
                ...(options.headers || {})
            }
        });

        const json = await response.json();
        if (!response.ok) {
            throw new Error(json.message || 'Errore API');
        }

        return json;
    };

    function setStatus(message) {
        const target = region('status');
        if (target) {
            target.textContent = message;
        }
    }

    function dispatchBridgeEvent(name, detail = {}) {
        app.dispatchEvent(new CustomEvent(name, { detail }));
    }

    function escapeHtml(value) {
        return String(value || '').replace(/[&<>"']/g, (char) => ({
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        }[char]));
    }

    function normalizeMessageBodyHtml(html, plainText) {
        if (!html) {
            return `<div class="v24-smh-body-content"><pre>${escapeHtml(plainText || '')}</pre></div>`;
        }

        return `<div class="v24-smh-body-content">${sanitizeMessageBodyHtml(html)}</div>`;
    }

    function sanitizeMessageBodyHtml(html) {
        return String(html || '')
            .replace(/<!--[\s\S]*?-->/g, '')
            .replace(/<\/?o:[^>]+>/gi, '')
            .replace(/<p[^>]*class=["'][^"']*MsoNormal[^"']*["'][^>]*>(?:\s|&nbsp;|&#160;|<br\s*\/?>)*<\/p>/gi, '')
            .replace(/(<div[^>]*class=["'][^"']*WordSection[^"']*["'][^>]*>)(?:\s*<(?:p|div)[^>]*>(?:\s|&nbsp;|&#160;|<br\s*\/?>)*<\/(?:p|div)>)+/gi, '$1')
            .replace(/(?:<(?:p|div)[^>]*>(?:\s|&nbsp;|&#160;|<br\s*\/?>)*<\/(?:p|div)>\s*)+(<\/div>\s*)$/gi, '$1')
            .replace(/^(?:\s*<(?:p|div)[^>]*>(?:\s|&nbsp;|&#160;|<br\s*\/?>)*<\/(?:p|div)>)+/gi, '')
            .replace(/(?:<(?:p|div)[^>]*>(?:\s|&nbsp;|&#160;|<br\s*\/?>)*<\/(?:p|div)>\s*)+$/gi, '')
            .trim();
    }

    function safeJson(value, fallback = []) {
        if (!value) {
            return Array.isArray(fallback) ? [...fallback] : fallback;
        }

        if (Array.isArray(value)) {
            return value;
        }

        try {
            const parsed = JSON.parse(value);
            return parsed == null ? fallback : parsed;
        } catch (error) {
            return Array.isArray(fallback) ? [...fallback] : fallback;
        }
    }

    function splitAddresses(value) {
        return String(value || '')
            .split(/[;,]/)
            .map((item) => item.trim())
            .filter(Boolean);
    }

    function splitCsv(value) {
        return String(value || '')
            .split(',')
            .map((item) => item.trim())
            .filter(Boolean);
    }

    function splitAttendees(value) {
        return String(value || '')
            .split(',')
            .map((item) => item.trim())
            .filter(Boolean)
            .map((item) => {
                const match = item.match(/^(.*)<([^>]+)>$/);
                if (match) {
                    return {
                        name: match[1].trim().replace(/^"|"$/g, ''),
                        email: match[2].trim()
                    };
                }

                return {
                    name: '',
                    email: item
                };
            })
            .filter((item) => item.email);
    }

    function formatDateTime(value) {
        if (!value) {
            return '';
        }

        return String(value).replace(' ', 'T').slice(0, 16);
    }

    function toMysqlDateTime(value) {
        if (!value) {
            return '';
        }

        return `${value.replace('T', ' ')}:00`;
    }

    function formatDisplayDate(value) {
        if (!value) {
            return '';
        }

        const date = new Date(String(value).replace(' ', 'T'));
        if (Number.isNaN(date.getTime())) {
            return String(value);
        }

        return date.toLocaleString('it-IT', {
            year: 'numeric',
            month: '2-digit',
            day: '2-digit',
            hour: '2-digit',
            minute: '2-digit'
        });
    }

    function highlightSelection(target, attribute, value) {
        if (!target) {
            return;
        }

        target.querySelectorAll(`[${attribute}]`).forEach((element) => {
            element.classList.toggle('is-active', String(element.getAttribute(attribute)) === String(value));
        });
    }

    function createButton(label, className) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = className || '';
        button.textContent = label;
        return button;
    }

    function createOption(value, label, selected) {
        const option = document.createElement('option');
        option.value = String(value ?? '');
        option.textContent = label;
        if (selected) {
            option.selected = true;
        }
        return option;
    }

    async function copyTextToClipboard(value) {
        const text = String(value || '');
        if (!text) {
            return;
        }

        if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
            await navigator.clipboard.writeText(text);
            return;
        }

        const input = document.createElement('textarea');
        input.value = text;
        input.setAttribute('readonly', 'readonly');
        input.style.position = 'fixed';
        input.style.left = '-9999px';
        document.body.appendChild(input);
        input.focus();
        input.select();
        document.execCommand('copy');
        input.remove();
    }

    function folderPrefsKey(accountId) {
        return `v24-smh-folder-prefs:${currentUserId}:${Number(accountId || 0)}`;
    }

    function folderOrderSeedMap(folders, seedIds = []) {
        const entries = new Map((folders || []).map((folder, index) => [Number(folder.id), { folder, index }]));
        const map = {};
        const pushFolder = (folder) => {
            const parentKey = folderParentKey(folder);
            const folderId = Number(folder.id);
            if (!folderId) {
                return;
            }

            if (!map[parentKey]) {
                map[parentKey] = [];
            }

            if (!map[parentKey].includes(folderId)) {
                map[parentKey].push(folderId);
            }
        };

        seedIds.forEach((folderId) => {
            const entry = entries.get(Number(folderId));
            if (entry) {
                pushFolder(entry.folder);
            }
        });

        (folders || []).forEach(pushFolder);
        return map;
    }

    function normalizeFolderPrefs(accountId, folders, value) {
        const knownIds = new Set((folders || []).map((folder) => Number(folder.id)).filter((id) => id > 0));
        const source = value && typeof value === 'object' ? value : {};
        const favorites = Array.from(new Set(safeJson(source.favorites).map((id) => Number(id)).filter((id) => knownIds.has(id))));
        const legacyOrder = Array.from(new Set(safeJson(source.order).map((id) => Number(id)).filter((id) => knownIds.has(id))));
        const defaultOrderMap = folderOrderSeedMap(folders, legacyOrder);
        const rawOrderMap = source.orderMap && typeof source.orderMap === 'object' ? source.orderMap : {};
        const orderMap = {};

        Object.keys(defaultOrderMap).forEach((parentKey) => {
            const validSiblings = new Set(defaultOrderMap[parentKey]);
            const preferredOrder = Array.isArray(rawOrderMap[parentKey])
                ? rawOrderMap[parentKey].map((id) => Number(id)).filter((id) => validSiblings.has(id))
                : [];

            orderMap[parentKey] = Array.from(new Set(preferredOrder));
            defaultOrderMap[parentKey].forEach((id) => {
                if (!orderMap[parentKey].includes(id)) {
                    orderMap[parentKey].push(id);
                }
            });
        });

        return {
            accountId: Number(accountId || 0),
            favorites,
            orderMap
        };
    }

    function readFolderPrefs(accountId, folders = state.folders) {
        if (!accountId) {
            return normalizeFolderPrefs(accountId, folders, null);
        }

        try {
            const raw = window.localStorage.getItem(folderPrefsKey(accountId));
            return normalizeFolderPrefs(accountId, folders, raw ? JSON.parse(raw) : null);
        } catch (error) {
            return normalizeFolderPrefs(accountId, folders, null);
        }
    }

    function writeFolderPrefs(accountId, prefs, folders = state.folders) {
        const normalized = normalizeFolderPrefs(accountId, folders, prefs);
        if (!accountId) {
            return normalized;
        }

        try {
            window.localStorage.setItem(folderPrefsKey(accountId), JSON.stringify(normalized));
        } catch (error) {
            return normalized;
        }

        return normalized;
    }

    function folderUrl(folder) {
        const url = new URL(window.location.href);
        const accountId = Number(folder?.account_id || state.accountId || 0);
        const folderId = Number(folder?.id || state.folderId || 0);

        if (accountId) {
            url.searchParams.set('smh_account', String(accountId));
        } else {
            url.searchParams.delete('smh_account');
        }

        if (folderId) {
            url.searchParams.set('smh_folder', String(folderId));
        } else {
            url.searchParams.delete('smh_folder');
        }

        return url.toString();
    }

    function syncFolderRoute() {
        if (!window.history || typeof window.history.replaceState !== 'function') {
            return;
        }

        window.history.replaceState({}, '', folderUrl());
    }

    function boolFromSelect(value) {
        if (value === '' || value === null || value === undefined) {
            return null;
        }

        return String(value) === '1';
    }

    function syncComposeBody() {
        const editor = composeEditor();
        const hidden = composeField('body');
        if (!editor || !hidden) {
            return '';
        }

        const html = editor.innerHTML || '';
        hidden.value = html.trim();
        return hidden.value;
    }

    function setComposeBodyHtml(html) {
        const editor = composeEditor();
        if (!editor) {
            return;
        }

        editor.innerHTML = html || '';
        syncComposeBody();
    }

    function closeCompose() {
        const compose = region('compose');
        if (compose) {
            compose.hidden = true;
        }
        dispatchBridgeEvent('v24-smh-compose-closed', {
            accountId: state.accountId,
            composeMode: state.composeMode
        });
    }

    function renderComposeContext(message, mode) {
        const target = region('compose-context');
        if (!target) {
            return;
        }

        if (!message || !['reply', 'reply_all', 'forward'].includes(mode)) {
            target.hidden = true;
            target.innerHTML = '';
            return;
        }

        const preview = (message.body_plain || '').trim().slice(0, 420);
        target.hidden = false;
        target.innerHTML = `
            <strong>Contesto originale</strong>
            <span>${escapeHtml(message.from_name || message.from_email || '')} | ${escapeHtml(message.subject || '')}</span>
            <p>${escapeHtml(preview || 'Contenuto disponibile nel pannello messaggio.')}</p>
        `;
    }

    function insertIntoCompose(html, subject) {
        const editor = composeEditor();
        if (!editor) {
            return;
        }

        const insertHtml = String(html || '').trim();
        if (!insertHtml) {
            return;
        }

        if (subject) {
            composeField('subject').value = subject;
        }

        const current = editor.innerHTML || '';
        const signatureRegex = /<div[^>]*id=["']?_rc_sig["']?[^>]*>[\s\S]*?<\/div>/i;
        const markerRegex = /<div[^>]*data-v24-smh-signature[^>]*>[\s\S]*?<\/div>/i;
        const plainSignature = /\n--\s*\n[\s\S]*$/i;
        const signatureMatch = current.match(signatureRegex) || current.match(markerRegex);
        const hasRichSignature = Boolean(signatureMatch);
        const spacer = current.trim() ? '<br><br>' : '';

        if (state.composeMode === 'reply' || state.composeMode === 'reply_all') {
            if (hasRichSignature && signatureMatch) {
                const signatureHtml = signatureMatch[0];
                const withoutSignature = current.replace(signatureMatch[0], '');
                editor.innerHTML = `${insertHtml}${spacer}${withoutSignature}${signatureHtml}`;
            } else {
                editor.innerHTML = `${insertHtml}${spacer}${current}`;
            }
        } else if (hasRichSignature && signatureMatch) {
            editor.innerHTML = current.replace(signatureMatch[0], `${insertHtml}${spacer}${signatureMatch[0]}`);
        } else if (plainSignature.test(current)) {
            editor.innerHTML = current.replace(plainSignature, `${insertHtml}${spacer}$&`);
        } else if (!current.trim()) {
            editor.innerHTML = insertHtml;
        } else {
            editor.innerHTML = `${current}${spacer}${insertHtml}`;
        }

        syncComposeBody();
        editor.focus();
    }

    window.V24SMHBridge = {
        api,
        app,
        getState: () => ({ ...state }),
        setStatus,
        closeCompose,
        insertIntoCompose,
        syncComposeBody,
        setComposeBodyHtml,
        composeField: (name) => composeField(name),
        composeEditor,
    };

    function renderTagList(items, emptyText) {
        if (!items || !items.length) {
            return `<p>${escapeHtml(emptyText)}</p>`;
        }

        return `<div class="v24-smh-pill-list">${items.map((item) => `<span class="v24-smh-pill">${escapeHtml(item)}</span>`).join('')}</div>`;
    }

    function folderSourceName(folder) {
        return String(folder?.name || folder?.full_name || folder?.remote_id || '').trim();
    }

    function folderFullName(folder) {
        return String(folder?.full_name || folderSourceName(folder) || '').trim();
    }

    function folderDelimiter(folder) {
        const explicit = String(folder?.delimiter || '').trim();
        if (explicit) {
            return explicit;
        }

        const fullName = folderFullName(folder);
        if (fullName.includes('.')) {
            return '.';
        }

        return '/';
    }

    function folderAliasLabel(value) {
        const source = String(value || '').trim();
        const normalized = source.toLowerCase();

        const aliases = [
            { matches: ['trash', 'cestino'], label: 'Cestino' },
            { matches: ['sent', 'sent items', 'posta inviata'], label: 'Posta inviata' },
            { matches: ['drafts', 'draft', 'bozze'], label: 'Bozze' },
            { matches: ['archive', 'archives', 'archivio'], label: 'Archivio' },
            { matches: ['junk', 'posta indesiderata'], label: 'Posta indesiderata' },
            { matches: ['spam'], label: 'Spam' },
        ];

        const match = aliases.find((entry) => entry.matches.some((item) => normalized === item || normalized.includes(item)));
        return match ? match.label : (source || 'Cartella');
    }

    function isInboxFolder(folder) {
        const source = folderSourceName(folder).toUpperCase();
        return folder?.special_use === 'inbox'
            || source === 'INBOX'
            || String(folder?.full_name || '').toUpperCase() === 'INBOX'
            || String(folder?.remote_id || '').toUpperCase() === 'INBOX';
    }

    function folderParentKey(folder) {
        const delimiter = folderDelimiter(folder);
        const fullName = folderFullName(folder);
        if (!fullName) {
            return ROOT_FOLDER_GROUP;
        }

        const parts = fullName.split(delimiter).filter(Boolean);
        if (parts.length <= 1) {
            return ROOT_FOLDER_GROUP;
        }

        return parts.slice(0, -1).join(delimiter);
    }

    function folderDepth(folder) {
        const parentKey = folderParentKey(folder);
        if (parentKey === ROOT_FOLDER_GROUP) {
            return 0;
        }

        return parentKey.split(folderDelimiter(folder)).filter(Boolean).length;
    }

    function folderHasChildren(folder, folders = state.folders) {
        const parentFullName = folderFullName(folder);
        return (folders || []).some((candidate) => folderParentKey(candidate) === parentFullName);
    }

    function folderDisplayName(folder) {
        if (!folder) {
            return 'Cartella';
        }

        if (isInboxFolder(folder)) {
            return 'INBOX';
        }

        const source = folderSourceName(folder).replace(/^INBOX[./]/i, '').trim();
        return folderAliasLabel(source || 'Cartella');
    }

    function folderDisplayCount(folder) {
        const messageCount = Number(folder?.message_count);
        if (Number.isFinite(messageCount)) {
            return messageCount;
        }

        const unseenCount = Number(folder?.unseen_count);
        if (Number.isFinite(unseenCount)) {
            return unseenCount;
        }

        return null;
    }

    function folderDisplayLabel(folder) {
        const count = folderDisplayCount(folder);
        return count === null ? folderDisplayName(folder) : `${folderDisplayName(folder)} (${count})`;
    }

    function currentFolder() {
        return state.folders.find((folder) => Number(folder.id) === Number(state.folderId)) || null;
    }

    function folderById(id) {
        return state.folders.find((folder) => Number(folder.id) === Number(id)) || null;
    }

    function folderBySpecialUse(specialUse) {
        return state.folders.find((folder) => String(folder.special_use || '') === String(specialUse || '')) || null;
    }

    function messageById(id) {
        return state.messages.find((message) => Number(message.id) === Number(id)) || null;
    }

    function folderBaseName(folder) {
        const delimiter = folderDelimiter(folder);
        const fullName = folderFullName(folder);
        const parts = fullName.split(delimiter).filter(Boolean);
        return parts[parts.length - 1] || fullName || folderDisplayName(folder);
    }

    function folderListName(folder) {
        if (isInboxFolder(folder)) {
            return 'INBOX';
        }

        return folderAliasLabel(folderBaseName(folder));
    }

    function folderListLabel(folder) {
        const count = folderDisplayCount(folder);
        const name = folderListName(folder);
        return count === null ? name : `${name} (${count})`;
    }

    function folderSecondaryLabel(folder) {
        if (!folder) {
            return '';
        }

        const parentKey = folderParentKey(folder);
        if (!parentKey || parentKey === ROOT_FOLDER_GROUP || parentKey.toUpperCase() === 'INBOX') {
            return '';
        }

        return parentKey.replace(/^INBOX[./]/i, '');
    }

    function isProtectedFolder(folder) {
        return Boolean(folder?.special_use) || isInboxFolder(folder);
    }

    function isFavoriteFolder(folder) {
        if (!folder || !state.accountId) {
            return false;
        }

        return readFolderPrefs(state.accountId, state.folders).favorites.includes(Number(folder.id));
    }

    function sortFolderEntries(entries, parentKey, orderMap = {}) {
        const orderIndex = new Map(((orderMap[parentKey] || [])).map((id, index) => [Number(id), index]));
        return [...entries].sort((left, right) => {
            const inboxWeight = Number(isInboxFolder(right.folder)) - Number(isInboxFolder(left.folder));
            if (inboxWeight !== 0) {
                return inboxWeight;
            }

            const leftOrder = orderIndex.has(Number(left.folder.id)) ? orderIndex.get(Number(left.folder.id)) : Number.MAX_SAFE_INTEGER;
            const rightOrder = orderIndex.has(Number(right.folder.id)) ? orderIndex.get(Number(right.folder.id)) : Number.MAX_SAFE_INTEGER;
            if (leftOrder !== rightOrder) {
                return leftOrder - rightOrder;
            }

            return left.index - right.index;
        });
    }

    function orderedFolderSiblings(parentKey, folders = state.folders) {
        const prefs = readFolderPrefs(state.accountId, folders);
        const entries = (folders || [])
            .map((folder, index) => ({ folder, index }))
            .filter((entry) => folderParentKey(entry.folder) === parentKey);

        return sortFolderEntries(entries, parentKey, prefs.orderMap).map((entry) => entry.folder);
    }

    function foldersForDisplay(folders) {
        const prefs = readFolderPrefs(state.accountId, folders);
        const entriesByParent = new Map();
        const flattened = [];
        const visited = new Set();

        (folders || []).forEach((folder, index) => {
            const parentKey = folderParentKey(folder);
            if (!entriesByParent.has(parentKey)) {
                entriesByParent.set(parentKey, []);
            }

            entriesByParent.get(parentKey).push({ folder, index });
        });

        const visit = (parentKey) => {
            const entries = entriesByParent.get(parentKey) || [];
            sortFolderEntries(entries, parentKey, prefs.orderMap).forEach((entry) => {
                const folderId = Number(entry.folder.id);
                if (visited.has(folderId)) {
                    return;
                }

                visited.add(folderId);
                flattened.push(entry.folder);
                visit(folderFullName(entry.folder));
            });
        };

        visit(ROOT_FOLDER_GROUP);

        (folders || []).forEach((folder) => {
            const folderId = Number(folder.id);
            if (!visited.has(folderId)) {
                flattened.push(folder);
            }
        });

        return flattened;
    }

    function folderOrderIds() {
        return foldersForDisplay(state.folders).map((folder) => Number(folder.id));
    }

    function canMoveFolderInSidebar(folder, direction) {
        if (!folder) {
            return false;
        }

        const siblings = orderedFolderSiblings(folderParentKey(folder));
        const ids = siblings.map((item) => Number(item.id));
        const currentIndex = ids.indexOf(Number(folder.id));
        const targetIndex = currentIndex + direction;
        if (currentIndex < 0 || targetIndex < 0 || targetIndex >= ids.length) {
            return false;
        }

        const targetFolder = folderById(ids[targetIndex]);
        return !isInboxFolder(folder) && !isInboxFolder(targetFolder);
    }

    function updateFolderContextHighlight() {
        const target = region('folders');
        if (!target) {
            return;
        }

        target.querySelectorAll('[data-folder-id]').forEach((element) => {
            element.classList.toggle('is-context-active', String(element.getAttribute('data-folder-id')) === String(state.folderContextId));
        });
    }

    function ensureFolderContextMenu() {
        let menu = region('folder-context-menu');
        if (menu) {
            return menu;
        }

        menu = document.createElement('div');
        menu.hidden = true;
        menu.className = 'v24-smh-context-menu';
        menu.setAttribute('data-region', 'folder-context-menu');
        menu.addEventListener('click', (event) => event.stopPropagation());
        menu.addEventListener('contextmenu', (event) => event.preventDefault());
        app.appendChild(menu);
        return menu;
    }

    function closeFolderContextMenu() {
        const menu = ensureFolderContextMenu();
        menu.hidden = true;
        menu.innerHTML = '';
        state.folderContextId = null;
        updateFolderContextHighlight();
    }

    function ensureFolderDialog() {
        let backdrop = region('folder-dialog-backdrop');
        let sheet = region('folder-dialog');
        if (backdrop && sheet) {
            return { backdrop, sheet };
        }

        backdrop = document.createElement('div');
        backdrop.hidden = true;
        backdrop.className = 'v24-smh-dialog-backdrop';
        backdrop.setAttribute('data-region', 'folder-dialog-backdrop');
        backdrop.addEventListener('click', () => resolveFolderDialog(null));

        sheet = document.createElement('section');
        sheet.hidden = true;
        sheet.className = 'v24-smh-sheet v24-smh-folder-dialog';
        sheet.setAttribute('data-region', 'folder-dialog');
        sheet.addEventListener('click', (event) => {
            const closeTarget = event.target.closest('[data-folder-dialog-close]');
            const confirmTarget = event.target.closest('[data-folder-dialog-confirm]');
            if (closeTarget) {
                resolveFolderDialog(null);
            } else if (confirmTarget && confirmTarget.getAttribute('type') !== 'submit') {
                resolveFolderDialog(true);
            }
        });
        sheet.addEventListener('submit', (event) => {
            const form = event.target.closest('[data-folder-dialog-form]');
            if (!form) {
                return;
            }

            event.preventDefault();
            const input = sheet.querySelector('[data-region="folder-dialog-input"]');
            const select = sheet.querySelector('[data-region="folder-dialog-select"]');
            resolveFolderDialog(input ? input.value.trim() : (select ? select.value : true));
        });

        app.appendChild(backdrop);
        app.appendChild(sheet);
        return { backdrop, sheet };
    }

    function isFolderDialogOpen() {
        const dialog = ensureFolderDialog();
        return !dialog.sheet.hidden;

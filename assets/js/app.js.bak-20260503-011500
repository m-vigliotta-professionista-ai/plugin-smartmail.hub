                || sheet.querySelector('[data-folder-dialog-confirm]')
                || sheet.querySelector('[data-folder-dialog-close]');
            if (focusTarget && typeof focusTarget.focus === 'function') {
                focusTarget.focus();
                if (focusTarget.select) {
                    focusTarget.select();
                }

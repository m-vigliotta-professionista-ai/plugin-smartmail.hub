    function buildEventRecurrencePayload() {
        const frequency = eventField('recurrence-frequency').value;
        if (!frequency || frequency === 'none' || state.eventEditMode === 'occurrence') {
            return null;
        }

        return {
            frequency,
            interval: Number(eventField('recurrence-interval').value || 1),
            weekdays: splitCsv(eventField('recurrence-weekdays').value.toUpperCase()),
            monthly_mode: eventField('recurrence-monthly-mode').value,
            month_day: Number(eventField('recurrence-month-day').value || 1),
            nth_week: Number(eventField('recurrence-nth-week').value || 1),
            nth_weekday: eventField('recurrence-nth-weekday').value,
            months: splitCsv(eventField('recurrence-months').value).map((item) => Number(item)).filter((item) => item >= 1 && item <= 12),
            until: eventField('recurrence-until').value ? toMysqlDateTime(eventField('recurrence-until').value) : '',
            count: eventField('recurrence-count').value ? Number(eventField('recurrence-count').value) : ''
        };
    }

    async function submitEvent(event) {
        event.preventDefault();

        const payload = {
            calendar_id: Number(eventField('calendar').value || 0),
            title: eventField('title').value,
            location: eventField('location').value,
            start_at: toMysqlDateTime(eventField('start').value),
            end_at: toMysqlDateTime(eventField('end').value),
            timezone: eventField('timezone').value,
            status: eventField('status').value,
            busy_status: eventField('busy-status').value,
            reminder_minutes: eventField('reminder-minutes').value,
            is_all_day: eventField('all-day').checked,
            categories: splitCsv(eventField('categories').value),
            description: eventField('description').value,
            recurrence: buildEventRecurrencePayload(),
            attendees: splitAttendees(eventField('attendees').value).map((attendee) => ({
                email: attendee.email,
                name: attendee.name,
                role: 'required',
                response_status: 'needs_action'
            }))
        };

        let result;
        if (state.editingEventId) {
            if (state.eventEditMode === 'occurrence' && state.currentEvent && state.currentEvent.is_occurrence) {
                payload.scope = 'occurrence';
                payload.occurrence_start = state.currentEvent.occurrence_start;
            } else {
                payload.scope = 'series';
            }

            result = await api(`/calendar/events/${state.editingEventId}`, {
                method: 'PUT',
                body: JSON.stringify(payload)
            });
        } else {
            result = await api('/calendar/events', {
                method: 'POST',
                body: JSON.stringify(payload)
            });
        }

        region('event-form-sheet').hidden = true;
        await loadCalendars();
        await loadEvents();

        if (result.data && result.data.id) {
            const loaded = await api(`/calendar/events/${result.data.id}`);
            await openEvent(loaded.data);
        }

        setStatus('Evento salvato.');
    }


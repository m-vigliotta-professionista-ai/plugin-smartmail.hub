        updateMessageContextHighlight();
    }

    function messageMenuItems(message) {
        const archiveFolder = folderBySpecialUse('archive');
        const junkFolder = folderBySpecialUse('junk');

        return [
            { action: 'copy-message', label: 'Copia' },
            { type: 'separator' },
            { action: 'reply-message', label: 'Rispondi' },
            { action: 'reply-all-message', label: 'Rispondi a tutti' },
            { action: 'forward-message', label: 'Inoltra' },
            { type: 'separator' },
            { action: 'mark-read-message', label: message.is_seen ? 'Segna come non letto' : 'Segna come gia letto' },
            { action: 'flag-message', label: message.is_flagged ? 'Rimuovi contrassegno' : 'Contrassegna' },
            { action: 'move-message', label: 'Sposta...' },
            { action: 'archive-message', label: 'Archivia...', disabled: !archiveFolder || Number(archiveFolder.id) === Number(message.folder_id) },
            { action: 'junk-message', label: 'Posta indesiderata', disabled: !junkFolder || Number(junkFolder.id) === Number(message.folder_id) },
            { type: 'separator' },
            { action: 'delete-message', label: 'Elimina', danger: true }
        ];
    }

    function renderMessageContextMenu(message) {
        const menu = ensureMessageContextMenu();
        menu.innerHTML = messageMenuItems(message).map((item) => {
            if (item.type === 'separator') {
                return '<div class="v24-smh-context-menu-separator"></div>';
            }

            return `
                <button
                    type="button"
                    class="v24-smh-context-menu-item${item.danger ? ' is-danger' : ''}"
                    data-message-menu-action="${item.action}"
                    ${item.disabled ? 'disabled' : ''}
                >
                    <span>${escapeHtml(item.label)}</span>
                </button>
            `;
        }).join('');
        return menu;
    }

    function showMessageContextMenu(message, clientX, clientY) {
        if (!message) {
            return;
        }

        state.messageContextId = Number(message.id);
        updateMessageContextHighlight();

        const menu = renderMessageContextMenu(message);
        menu.hidden = false;
        menu.style.left = '0px';
        menu.style.top = '0px';

        const padding = 12;
        const maxLeft = Math.max(padding, window.innerWidth - menu.offsetWidth - padding);
        const maxTop = Math.max(padding, window.innerHeight - menu.offsetHeight - padding);
        menu.style.left = `${Math.min(Math.max(padding, clientX), maxLeft)}px`;
        menu.style.top = `${Math.min(Math.max(padding, clientY), maxTop)}px`;
    }

    async function ensureMessageLoaded(messageId) {
        if (state.currentMessage && Number(state.currentMessage.id) === Number(messageId)) {
            return state.currentMessage;
        }

        await openMessage(messageId);
        return state.currentMessage;
    }

    async function setMessageSeenById(messageId, isSeen) {
        await api(`/mail/messages/${messageId}/seen`, {
            method: 'POST',
            body: JSON.stringify({ is_seen: isSeen })
        });

        if (state.currentMessage && Number(state.currentMessage.id) === Number(messageId)) {
            state.currentMessage.is_seen = isSeen;
            renderMessage(state.currentMessage);
        }

        await loadMessages();
        setStatus(isSeen ? 'Messaggio segnato come letto.' : 'Messaggio segnato come non letto.');
    }

    async function setMessageFlagById(messageId, isFlagged) {
        await api(`/mail/messages/${messageId}/flag`, {
            method: 'POST',
            body: JSON.stringify({ is_flagged: isFlagged })
        });

        if (state.currentMessage && Number(state.currentMessage.id) === Number(messageId)) {
            state.currentMessage.is_flagged = isFlagged;
            renderMessage(state.currentMessage);
        }

        await loadMessages();
        setStatus(isFlagged ? 'Messaggio contrassegnato.' : 'Contrassegno rimosso.');
    }

    async function moveMessageToFolderId(messageId, targetFolderId, options = {}) {
        const result = await api(`/mail/messages/${messageId}/move`, {
            method: 'POST',
            body: JSON.stringify({ target_folder_id: targetFolderId })
        });

        const movedCurrent = state.currentMessage && Number(state.currentMessage.id) === Number(messageId);
        if (movedCurrent) {
            state.currentMessage = null;
            region('reader').innerHTML = `<p>${escapeHtml(options.readerMessage || 'Messaggio spostato.')}</p>`;
        }

        if (result.data && result.data.requires_sync) {
            await sync();
        } else {
            await loadMessages();
        }

        if (options.openTargetFolder) {
            await selectFolder(targetFolderId);
        }

        setStatus(options.successMessage || 'Messaggio spostato.');
    }

    async function deleteMessageById(messageId) {
        const result = await api(`/mail/messages/${messageId}/delete`, {
            method: 'POST',
            body: '{}'
        });

        if (state.currentMessage && Number(state.currentMessage.id) === Number(messageId)) {
            state.currentMessage = null;
            region('reader').innerHTML = '<p>Messaggio eliminato.</p>';
        }

        if (result.data && result.data.requires_sync) {
            await sync();
        } else {
            await loadMessages();
        }

        setStatus(result.data && result.data.moved_to_trash ? 'Messaggio spostato nel cestino.' : 'Messaggio eliminato.');
    }

    async function moveMessageWithDialog(message) {
        const options = foldersForDisplay(state.folders)
            .filter((folder) => Number(folder.id) !== Number(message.folder_id))
            .map((folder) => ({
                value: folder.id,
                label: folderSecondaryLabel(folder) ? `${folderListName(folder)} · ${folderSecondaryLabel(folder)}` : folderListName(folder)
            }));

        if (!options.length) {
            setStatus('Nessuna cartella di destinazione disponibile.');
            return;
        }

        const selected = await openFolderSelectDialog({
            title: 'Sposta messaggio',
            description: `Scegli la cartella di destinazione per ${message.subject || '(Senza oggetto)'}.`,
            label: 'Cartella destinazione',
            confirmLabel: 'Sposta',
            options
        });

        if (!selected) {
            return;
        }

        await moveMessageToFolderId(message.id, Number(selected), {
            openTargetFolder: false,
            readerMessage: 'Messaggio spostato.',
            successMessage: 'Messaggio spostato.'
        });
    }

    async function copyMessageToClipboard(messageId) {
        const message = await ensureMessageLoaded(messageId);
        const text = [
            `Da: ${message.from_name || message.from_email || ''}`,
            `A: ${(message.recipients || []).map((item) => item.name || item.email || '').filter(Boolean).join(', ')}`,
            `Oggetto: ${message.subject || '(Senza oggetto)'}`,
            '',
            message.body_plain || ''
        ].join('\n').trim();

        await copyTextToClipboard(text);
        setStatus('Contenuto messaggio copiato.');
    }

    async function composeFromMessage(messageId, mode) {
        await ensureMessageLoaded(messageId);
        openCompose(mode);
    }

    async function handleMessageMenuAction(action) {
        const message = messageById(state.messageContextId);
        closeMessageContextMenu();

        if (!message) {
            return;
        }

        if (action === 'copy-message') {
            await copyMessageToClipboard(message.id);
        } else if (action === 'reply-message') {
            await composeFromMessage(message.id, 'reply');
        } else if (action === 'reply-all-message') {
            await composeFromMessage(message.id, 'reply_all');
        } else if (action === 'forward-message') {
            await composeFromMessage(message.id, 'forward');
        } else if (action === 'mark-read-message') {
            await setMessageSeenById(message.id, !message.is_seen);
        } else if (action === 'flag-message') {
            await setMessageFlagById(message.id, !message.is_flagged);
        } else if (action === 'move-message') {
            await moveMessageWithDialog(message);
        } else if (action === 'archive-message') {
            const archiveFolder = folderBySpecialUse('archive');
            if (!archiveFolder) {
                setStatus('Cartella archivio non disponibile.');
                return;
            }

            await moveMessageToFolderId(message.id, Number(archiveFolder.id), {
                readerMessage: 'Messaggio archiviato.',
                successMessage: 'Messaggio archiviato.'
            });
        } else if (action === 'junk-message') {
            const junkFolder = folderBySpecialUse('junk');
            if (!junkFolder) {
                setStatus('Cartella posta indesiderata non disponibile.');
                return;
            }

            await moveMessageToFolderId(message.id, Number(junkFolder.id), {
                readerMessage: 'Messaggio spostato nella posta indesiderata.',
                successMessage: 'Messaggio spostato nella posta indesiderata.'
            });
        } else if (action === 'delete-message') {
            const confirmed = await openFolderConfirmDialog({
                title: 'Elimina messaggio',
                description: `Vuoi eliminare ${message.subject || '(Senza oggetto)'}?`,
                confirmLabel: 'Elimina',
                cancelLabel: 'Annulla',
                danger: true
            });
            if (!confirmed) {
                return;
            }

            await deleteMessageById(message.id);
        }
    }

    async function loadMessages() {
        if (!state.accountId || !state.folderId) {
            return;
        }

        setStatus('Caricamento messaggi...');
        const params = new URLSearchParams({
            account_id: state.accountId,
            folder_id: state.folderId,
            search: region('search').value || ''
        });
        const result = await api(`/mail/messages?${params.toString()}`);
        const messages = result.data || [];
        state.messages = messages;
        const target = region('messages');
        target.innerHTML = '';
        updateMailListHeader(messages.length);
        target.classList.toggle('is-empty', !messages.length);

        if (!messages.length) {
            closeMessageContextMenu();
            target.innerHTML = '<p>Nessun messaggio trovato.</p>';
            region('reader').innerHTML = '<p>La cartella e vuota o il filtro non ha restituito risultati.</p>';
            setStatus('Nessun messaggio.');
            return;
        }

        messages.forEach((message) => {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = `v24-smh-message${message.is_seen ? '' : ' is-unseen'}`;
            button.setAttribute('data-message-id', message.id);
            const tags = [];
            if (message.is_flagged) {
                tags.push('<span>Contrassegnato</span>');
            }
            if (message.has_attachments) {
                tags.push('<span>Allegati</span>');
            }
            button.innerHTML = `
                <div class="v24-smh-message-head">
                    <strong class="v24-smh-message-sender">${escapeHtml(message.from_name || message.from_email || '')}</strong>
                    ${renderEnvelopeIcon(Boolean(message.is_seen))}
                </div>
                <span class="v24-smh-message-subject">${escapeHtml(message.subject || '(Senza oggetto)')}</span>
                <small class="v24-smh-message-date">${escapeHtml(formatDisplayDate(message.date_received || ''))}</small>
                ${tags.length ? `<div class="v24-smh-message-meta">${tags.join('')}</div>` : ''}
            `;
            button.addEventListener('click', () => openMessage(message.id));
            button.addEventListener('contextmenu', (event) => {
                event.preventDefault();
                showMessageContextMenu(message, event.clientX, event.clientY);
            });
            button.addEventListener('keydown', (event) => {
                if (event.key === 'ContextMenu' || (event.shiftKey && event.key === 'F10')) {
                    event.preventDefault();
                    const rect = button.getBoundingClientRect();
                    showMessageContextMenu(message, rect.left + 20, rect.top + Math.min(rect.height, 48));
                }
            });
            target.appendChild(button);
        });

        if (state.currentMessage && messages.some((message) => Number(message.id) === Number(state.currentMessage.id))) {
            highlightSelection(target, 'data-message-id', state.currentMessage.id);
        }
        updateMessageContextHighlight();
        setStatus(`${messages.length} messaggi caricati.`);
    }

    async function openMessage(id) {
        closeMessageContextMenu();
        setStatus('Apertura messaggio...');
        const result = await api(`/mail/messages/${id}`);
        state.currentMessage = result.data;
        highlightSelection(region('messages'), 'data-message-id', id);
        renderMessage(state.currentMessage);
        dispatchBridgeEvent('v24-smh-message-selected', {
            accountId: state.accountId,
            folderId: state.folderId,
            message: state.currentMessage
        });
        setStatus('Messaggio aperto.');
    }


    function toggleFavoriteFolder(folder) {
        const prefs = readFolderPrefs(state.accountId, state.folders);
        const folderId = Number(folder.id);
        prefs.favorites = prefs.favorites.includes(folderId)
            ? prefs.favorites.filter((id) => Number(id) !== folderId)
            : [...prefs.favorites, folderId];
        writeFolderPrefs(state.accountId, prefs, state.folders);
        renderFolders();
        setStatus(prefs.favorites.includes(folderId) ? 'Cartella aggiunta ai Preferiti.' : 'Cartella rimossa dai Preferiti.');
    }

    function sortFolderChildrenAlphabetically(folder) {
        const parentKey = folderFullName(folder);
        const siblings = orderedFolderSiblings(parentKey);
        if (!siblings.length) {
            setStatus('Nessuna sottocartella da ordinare.');
            return;
        }

        const sortedIds = [...siblings]
            .sort((left, right) => folderListName(left).localeCompare(folderListName(right), 'it', { sensitivity: 'base' }))
            .map((item) => Number(item.id));
        const prefs = readFolderPrefs(state.accountId, state.folders);
        prefs.orderMap[parentKey] = sortedIds;
        writeFolderPrefs(state.accountId, prefs, state.folders);
        renderFolders();
        setStatus('Sottocartelle ordinate.');
    }


            renderRow('Principale', contact.primary_email ? `<a href="mailto:${escapeHtml(contact.primary_email)}">${escapeHtml(contact.primary_email)}</a>` : ''),
            ...extraEmails.map((email, index) => renderRow(`Altro ${index + 1}`, `<a href="mailto:${escapeHtml(email)}">${escapeHtml(email)}</a>`)),
            renderRow('Web', contact.website_url ? `<a href="${escapeHtml(contact.website_url)}" target="_blank" rel="noopener noreferrer">${escapeHtml(contact.website_url)}</a>` : '')
        ].join('');

        const phoneRows = [
            renderRow('Cellulare', escapeHtml(contact.mobile_phone || '')),
            renderRow('Ufficio', escapeHtml(contact.business_phone || '')),
            ...extraPhones.map((phone, index) => renderRow(`Altro ${index + 1}`, escapeHtml(phone)))
        ].join('');

        const addressRows = addresses.length
            ? addresses.map((address, index) => renderRow(`Indirizzo ${index + 1}`, escapeHtml(address))).join('')
            : renderRow('Indirizzo', '');

        region('contact-reader').innerHTML = `
            <article class="v24-smh-contact-card">
                <div class="v24-smh-contact-hero">
                    <div class="v24-smh-contact-avatar v24-smh-contact-avatar-xl">${escapeHtml(contactInitials(contact))}</div>
                    <div class="v24-smh-contact-hero-copy">
                        <span class="v24-smh-contact-kicker">${escapeHtml((groups[0] || 'Contatti personali'))}</span>
                        <h2>${escapeHtml(contactDisplayName(contact))}</h2>
                        <p>${escapeHtml(summary)}</p>
                    </div>

    function contactInitials(contact) {
        const tokens = contactDisplayName(contact).split(/\s+/).filter(Boolean);
        return (tokens.slice(0, 2).map((token) => token.charAt(0).toUpperCase()).join('') || 'CT').slice(0, 2);
    }

    function contactGroupsFor(contact) {
        const groups = [];

        safeJson(contact.categories_json).forEach((category) => {
            const label = String(category || '').trim();
            if (!label) {
                return;
            }

            groups.push({
                section: 'Categorie',
                key: `cat:${slugify(label)}`,
                label
            });
        });

        if (contact.company) {
            groups.push({
                section: 'Aziende',
                key: `company:${slugify(contact.company)}`,
                label: contact.company
            });
        }

        return Array.from(new Map(groups.map((group) => [group.key, group])).values());
    }

    function buildContactGroupCatalog(contacts) {
        const catalog = [{
            section: 'Contatti',
            key: 'all',
            label: 'Contatti personali',
            hint: 'Tutte le schede',
            count: contacts.length
        }];

        const ungroupedCount = contacts.filter((contact) => !contactGroupsFor(contact).length).length;
        if (ungroupedCount) {
            catalog.push({
                section: 'Contatti',
                key: 'ungrouped',
                label: 'Senza gruppo',
                hint: 'Contatti non classificati',
                count: ungroupedCount
            });
        }

        const map = new Map();
        contacts.forEach((contact) => {
            contactGroupsFor(contact).forEach((group) => {
                const existing = map.get(group.key) || {
                    section: group.section,
                    key: group.key,
                    label: group.label,
                    hint: group.section === 'Categorie' ? 'Categoria contatto' : 'Azienda collegata',
                    count: 0
                };
                existing.count += 1;
                map.set(group.key, existing);
            });
        });

        return catalog.concat(Array.from(map.values()).sort((left, right) => (
            left.section.localeCompare(right.section, 'it') || left.label.localeCompare(right.label, 'it')
        )));
    }

    function contactBelongsToGroup(contact, groupKey) {
        if (groupKey === 'all') {
            return true;
        }

        const groups = contactGroupsFor(contact);
        if (groupKey === 'ungrouped') {
            return !groups.length;
        }

        return groups.some((group) => group.key === groupKey);
    }

    function getVisibleContacts() {
        return state.contacts.filter((contact) => contactBelongsToGroup(contact, state.contactGroup));

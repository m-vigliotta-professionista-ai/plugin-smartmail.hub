        }

        await api(`/rules/${state.currentRule.id}`, { method: 'DELETE' });
        state.currentRule = null;
        region('rule-reader').innerHTML = '<p>Regola eliminata.</p>';
        await loadRules();
        setStatus('Regola eliminata.');
    }

    async function runRules(ruleId) {
        if (!state.rulesAccountId) {
            return;
        }

        const result = await api('/rules/run', {
            method: 'POST',
            body: JSON.stringify({
                account_id: state.rulesAccountId,
                rule_id: ruleId || null
            })
        });

        const data = result.data || {};
        await loadRules({ silentStatus: true });
        if (state.currentRule && state.currentRule.id) {
            await openRule(state.currentRule.id, { silentStatus: true });
        }
        setStatus(`Regole eseguite. Messaggi analizzati: ${data.processed || 0}, match: ${data.matched || 0}.`);
    }

    app.addEventListener('contextmenu', (event) => {
        if (!event.target.closest('[data-folder-id]') && !event.target.closest('[data-region="folder-context-menu"]')) {
            closeFolderContextMenu();
        }
        if (!event.target.closest('[data-message-id]') && !event.target.closest('[data-region="message-context-menu"]')) {
            closeMessageContextMenu();
        }
    });

    document.addEventListener('click', (event) => {
        if (!event.target.closest('[data-region="folder-context-menu"]') && !event.target.closest('[data-folder-id]')) {
            closeFolderContextMenu();
        }
        if (!event.target.closest('[data-region="message-context-menu"]') && !event.target.closest('[data-message-id]')) {
            closeMessageContextMenu();
        }
    });

    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
            if (isFolderDialogOpen()) {
                resolveFolderDialog(null);
                return;
            }
            closeFolderContextMenu();
            closeMessageContextMenu();
        }
    });

    window.addEventListener('resize', () => {
        closeFolderContextMenu();
        closeMessageContextMenu();
    });

    app.addEventListener('click', async (event) => {
        const folderMenuAction = event.target.closest('[data-folder-menu-action]');
        if (folderMenuAction) {
            try {
                await handleFolderMenuAction(folderMenuAction.getAttribute('data-folder-menu-action'));
            } catch (error) {
                setStatus(error.message || 'Operazione cartella non riuscita.');
            }
            return;
        }

        const messageMenuAction = event.target.closest('[data-message-menu-action]');
        if (messageMenuAction) {
            try {
                await handleMessageMenuAction(messageMenuAction.getAttribute('data-message-menu-action'));
            } catch (error) {
                setStatus(error.message || 'Operazione messaggio non riuscita.');
            }
            return;
        }

        const actionTarget = event.target.closest('[data-action]');
        if (!actionTarget) {
            return;
        }

        const action = actionTarget.getAttribute('data-action');

        try {
            if (action === 'switch-module') {
                setActiveModule(actionTarget.getAttribute('data-module'));
            } else if (action === 'sync') {
                await sync();
            } else if (action === 'compose') {
                openCompose('new');
            } else if (action === 'close-compose') {
                closeCompose();
            } else if (action === 'search') {
                await loadMessages();
            } else if (action === 'reply') {
                openCompose('reply');
            } else if (action === 'reply-all') {
                openCompose('reply_all');
            } else if (action === 'forward') {
                openCompose('forward');
            } else if (action === 'toggle-seen') {
                await toggleSeen();
            } else if (action === 'toggle-flag') {
                await toggleFlag();
            } else if (action === 'move-message') {
                await moveCurrentMessage();
            } else if (action === 'delete-message') {
                await deleteCurrentMessage();
            } else if (action === 'download-attachment') {
                await downloadAttachment(actionTarget.getAttribute('data-attachment-id'));
            } else if (action === 'search-contacts') {
                await loadContacts();
            } else if (action === 'select-contact-group') {
                state.contactGroup = actionTarget.getAttribute('data-group-key') || 'all';
                renderContactGroups();
                renderContactList();
            } else if (action === 'new-contact') {
                openContactForm(null);
            } else if (action === 'close-contact-form') {
                closeContactForm();
            } else if (action === 'edit-contact' && state.currentContact) {
                openContactForm(state.currentContact);
            } else if (action === 'delete-contact') {
                await deleteCurrentContact();
            } else if (action === 'compose-contact' && state.currentContact) {
                openComposeTo(state.currentContact.primary_email || '');
            } else if (action === 'switch-calendar-view') {
                state.calendarView = actionTarget.getAttribute('data-view') || 'week';
                ensureCalendarRange();
                await loadEvents();
            } else if (action === 'calendar-prev') {
                calendarNavigate(-1);
                await loadEvents();
            } else if (action === 'calendar-next') {
                calendarNavigate(1);
                await loadEvents();
            } else if (action === 'calendar-today') {
                calendarNavigate('today');
                await loadEvents();
            } else if (action === 'calendar-mini-day') {
                state.calendarCursor = actionTarget.getAttribute('data-date') || formatDateOnly(new Date());
                if (actionTarget.classList.contains('v24-smh-calendar-day-head')) {
                    state.calendarView = 'day';
                }
                await loadEvents();
            } else if (action === 'open-calendar-event') {
                await openEventByKey(actionTarget.getAttribute('data-event-key'));
            } else if (action === 'new-event-slot') {
                const date = actionTarget.getAttribute('data-date') || formatDateOnly(new Date());
                const hour = Number(actionTarget.getAttribute('data-hour') || 9);
                const startAt = `${date} ${pad2(hour)}:00:00`;
                const endAt = `${date} ${pad2(Math.min(hour + 1, 23))}:00:00`;
                openEventForm({
                    calendar_id: state.currentCalendar ? state.currentCalendar.id : selectedEditableCalendarId(),
                    start_at: startAt,
                    end_at: endAt
                }, 'series');
            } else if (action === 'load-calendar') {
                await loadEvents();
            } else if (action === 'new-calendar') {
                await loadWorkspaceUsers();
                openCalendarForm(null);
            } else if (action === 'new-event') {
                openEventForm(null, 'series');
            } else if (action === 'new-event-on-calendar') {
                openEventForm({
                    calendar_id: state.currentCalendar ? state.currentCalendar.id : selectedEditableCalendarId()
                }, 'series');
            } else if (action === 'close-event-form') {
                region('event-form-sheet').hidden = true;
            } else if (action === 'close-calendar-form') {
                region('calendar-form-sheet').hidden = true;
            } else if (action === 'edit-calendar' && state.currentCalendar) {
                await loadWorkspaceUsers();
                openCalendarForm(state.currentCalendar);
            } else if (action === 'delete-calendar') {
                await deleteCurrentCalendar();
            } else if (action === 'edit-event' && state.currentEvent) {
                openEventForm(state.currentEvent, 'series');
            } else if (action === 'edit-event-series' && state.currentEvent) {
                openEventForm(state.currentEvent, 'series');
            } else if (action === 'edit-event-occurrence' && state.currentEvent) {
                openEventForm(state.currentEvent, 'occurrence');
            } else if (action === 'delete-event') {
                await deleteCurrentEvent('series');
            } else if (action === 'delete-event-occurrence') {
                await deleteCurrentEvent('occurrence');
            } else if (action === 'load-tasks') {
                await loadTasks();
            } else if (action === 'new-task') {
                await loadWorkspaceUsers();
                openTaskForm(null);
            } else if (action === 'edit-task' && state.currentTask) {
                await loadWorkspaceUsers();
                openTaskForm(state.currentTask);
            } else if (action === 'delete-task') {
                await deleteCurrentTask();
            } else if (action === 'close-task-form') {
                region('task-form-sheet').hidden = true;
            } else if (action === 'load-rules') {
                await loadRulesContext();
            } else if (action === 'new-rule') {
                await loadRulesContext();
                openRuleForm(null);
            } else if (action === 'edit-rule' && state.currentRule) {
                openRuleForm(state.currentRule);
            } else if (action === 'delete-rule') {
                await deleteCurrentRule();
            } else if (action === 'close-rule-form') {
                region('rule-form-sheet').hidden = true;
            } else if (action === 'run-rules') {
                await runRules(null);
            } else if (action === 'run-current-rule' && state.currentRule) {
                await runRules(state.currentRule.id);
            }
        } catch (error) {
            setStatus(error.message || 'Operazione non riuscita.');
        }
    });

    app.querySelector('[data-form="compose"]').addEventListener('submit', (event) => {
        submitCompose(event).catch((error) => setStatus(error.message || 'Invio non riuscito.'));
    });

    if (composeEditor()) {
        composeEditor().addEventListener('input', () => {
            syncComposeBody();
        });
    }

    app.querySelector('[data-form="contact"]').addEventListener('submit', (event) => {
        submitContact(event).catch((error) => setStatus(error.message || 'Salvataggio contatto non riuscito.'));
    });

    app.querySelector('[data-form="event"]').addEventListener('submit', (event) => {
        submitEvent(event).catch((error) => setStatus(error.message || 'Salvataggio evento non riuscito.'));
    });

    app.querySelector('[data-form="calendar"]').addEventListener('submit', (event) => {
        submitCalendar(event).catch((error) => setStatus(error.message || 'Salvataggio calendario non riuscito.'));
    });

    app.querySelector('[data-form="task"]').addEventListener('submit', (event) => {
        submitTask(event).catch((error) => setStatus(error.message || 'Salvataggio task non riuscito.'));
    });

    app.querySelector('[data-form="rule"]').addEventListener('submit', (event) => {
        submitRule(event).catch((error) => setStatus(error.message || 'Salvataggio regola non riuscito.'));
    });

    region('search').addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
            event.preventDefault();
            loadMessages().catch((error) => setStatus(error.message || 'Ricerca non riuscita.'));
        }
    });

    region('contacts-search').addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
            event.preventDefault();
            loadContacts().catch((error) => setStatus(error.message || 'Ricerca contatti non riuscita.'));
        }
    });

    if (region('contact-groups-search')) {
        region('contact-groups-search').addEventListener('input', () => {
            renderContactGroups();
        });
    }

    if (region('calendar-search')) {
        region('calendar-search').addEventListener('keydown', (event) => {
            if (event.key === 'Enter') {
                event.preventDefault();
                renderCalendarBoard();
            }
        });
        region('calendar-search').addEventListener('input', () => {
            renderCalendarBoard();
        });
    }

    if (region('calendar-filter')) {
        region('calendar-filter').addEventListener('input', () => {
            renderCalendars();
        });
    }

    region('tasks-search').addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
            event.preventDefault();
            loadTasks().catch((error) => setStatus(error.message || 'Ricerca task non riuscita.'));
        }
    });

    region('rules-account').addEventListener('change', (event) => {
        state.rulesAccountId = Number(event.target.value || 0);
        loadRulesContext().catch((error) => setStatus(error.message || 'Cambio account regole non riuscito.'));
    });

    ensureCalendarRange();
    loadAccounts().catch((error) => setStatus(error.message || 'Caricamento iniziale non riuscito.'));
})();

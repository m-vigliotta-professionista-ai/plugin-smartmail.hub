                    <p><strong>Inizio:</strong> ${escapeHtml(formatDisplayDate(calendarEvent.start_at))}</p>
                    <p><strong>Fine:</strong> ${escapeHtml(formatDisplayDate(calendarEvent.end_at))}</p>
                    <p><strong>Luogo:</strong> ${escapeHtml(calendarEvent.location || '-')}</p>
                    <p><strong>Stato:</strong> ${escapeHtml(calendarEvent.status || 'confirmed')}</p>
                    <p><strong>Disponibilita:</strong> ${escapeHtml(calendarEvent.busy_status || 'busy')}</p>
                    <p><strong>Promemoria:</strong> ${calendarEvent.reminder_minutes !== null && calendarEvent.reminder_minutes !== '' ? `${escapeHtml(calendarEvent.reminder_minutes)} min` : '-'}</p>
                    <p><strong>Ricorrenza:</strong> ${escapeHtml(recurrenceSummary(calendarEvent.recurrence))}</p>
                </div>
                <div class="v24-smh-reader-actions">
                    ${standardActions}
                    ${occurrenceActions}
                </div>
            </div>
            <div class="v24-smh-detail-grid">

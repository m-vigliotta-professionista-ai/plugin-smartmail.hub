.v24-smh-compose {
    background:
        radial-gradient(circle at top right, rgba(61, 217, 255, 0.12), transparent 24%),
        radial-gradient(circle at bottom left, rgba(255, 79, 167, 0.12), transparent 28%),
        linear-gradient(180deg, rgba(12, 20, 40, 0.98), rgba(6, 12, 24, 0.98));
}

.v24-smh-compose-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(360px, 0.95fr);
    min-height: calc(100vh - 180px);
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid rgba(121, 148, 210, 0.18);
    background: rgba(8, 14, 29, 0.55);
}

.v24-smh-compose-main {
    padding: 24px;
    border-right: 1px solid rgba(121, 148, 210, 0.18);
    background:
        linear-gradient(180deg, rgba(17, 28, 57, 0.9), rgba(10, 18, 36, 0.94)),
        linear-gradient(135deg, rgba(61, 217, 255, 0.04), rgba(255, 79, 167, 0.03));
}

.v24-smh-compose-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
}

.v24-smh-compose-toolbar-hint {
    display: inline-flex;
    align-items: center;
    padding: 8px 12px;
    border-radius: 999px;
    background: rgba(61, 217, 255, 0.08);
    border: 1px solid rgba(61, 217, 255, 0.14);
}

.v24-smh-compose-context {
    margin-bottom: 14px;
    padding: 16px;
    border-radius: 18px;
    border: 1px solid rgba(61, 217, 255, 0.18);
    background: linear-gradient(135deg, rgba(61, 217, 255, 0.09), rgba(16, 25, 46, 0.86));
}

.v24-smh-compose-context strong,
.v24-smh-compose-context span {
    display: block;
}

.v24-smh-compose-context p {
    margin: 10px 0 0;
    color: var(--v24-text-soft);
}

.v24-smh-compose-editor,
.v24-smh-ai-direct-editor,
.v24-smh-ai-response-html {
    min-height: 320px;
    padding: 18px;
    border-radius: 20px;
    border: 1px solid rgba(121, 148, 210, 0.18);
    background: rgba(4, 10, 24, 0.8);
    color: var(--v24-text);
    overflow: auto;
    line-height: 1.65;
}

.v24-smh-ai-direct-editor {
    min-height: 160px;
}

.v24-smh-compose-editor:focus,
.v24-smh-ai-direct-editor:focus,
.v24-smh-ai-response-html.is-editing {
    outline: none;
    border-color: rgba(61, 217, 255, 0.42);
    box-shadow: 0 0 0 4px rgba(61, 217, 255, 0.08);
}

.v24-smh-ai-dock {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    background:
        linear-gradient(180deg, rgba(11, 20, 42, 0.96), rgba(7, 13, 28, 0.98)),
        radial-gradient(circle at top left, rgba(140, 99, 255, 0.12), transparent 34%);
    overflow: auto;
}

.v24-smh-ai-brand {
    display: grid;
    gap: 6px;
    padding: 18px;
    border-radius: 22px;
    border: 1px solid rgba(61, 217, 255, 0.18);
    background: linear-gradient(135deg, rgba(61, 217, 255, 0.12), rgba(140, 99, 255, 0.08));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
}

.v24-smh-ai-brand strong {
    font-family: "Sora", "Manrope", sans-serif;
    font-size: 20px;
}

.v24-smh-ai-brand span,
.v24-smh-ai-brand em {
    color: var(--v24-text-soft);
    font-style: normal;
}

.v24-smh-ai-section {
    display: grid;
    gap: 12px;
    padding: 16px 18px;
    border-radius: 22px;
    border: 1px solid rgba(121, 148, 210, 0.16);
    background: rgba(17, 28, 57, 0.72);
}

.v24-smh-ai-section-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
}

.v24-smh-ai-section-head h3 {
    margin: 0;
    font-family: "Sora", "Manrope", sans-serif;
    font-size: 17px;
}

.v24-smh-ai-inline-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.v24-smh-ai-grid {
    gap: 12px;
}

.v24-smh-ai-grid-wide {
    grid-column: 1 / -1;
}

.v24-smh-ai-prompt-wrap {
    display: grid;
    gap: 10px;
}

.v24-smh-ai-scope {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 14px;
    align-items: center;
    font-size: 13px;
    color: var(--v24-text-soft);
}

.v24-smh-ai-scope span {
    color: #ffffff;
    font-weight: 700;
}

.v24-smh-ai-prefs {
    gap: 14px;
}

.v24-smh-ai-context strong {
    display: block;
    margin-bottom: 8px;
}

.v24-smh-ai-context p {
    margin: 0;
    color: var(--v24-text-soft);
    white-space: pre-wrap;
}

.v24-smh-ai-responses {
    display: grid;
    gap: 14px;
}

.v24-smh-ai-card {
    border-radius: 22px;
    border: 1px solid rgba(121, 148, 210, 0.16);
    background: rgba(8, 14, 28, 0.78);
    overflow: hidden;
}

.v24-smh-ai-card.is-selected {
    border-color: rgba(61, 217, 255, 0.34);
    box-shadow: 0 0 0 1px rgba(61, 217, 255, 0.12), 0 18px 36px rgba(0, 7, 19, 0.26);
}

.v24-smh-ai-card-head,
.v24-smh-ai-card-foot {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 16px;
}

.v24-smh-ai-card-head {
    align-items: flex-start;
    border-bottom: 1px solid rgba(121, 148, 210, 0.12);
}

.v24-smh-ai-card-title {
    display: grid;
    gap: 4px;
    background: transparent;
    border: 0;
    padding: 0;
    text-align: left;
    cursor: pointer;
    color: inherit;
}

.v24-smh-ai-card-title strong {
    font-size: 16px;
}

.v24-smh-ai-card-title span {
    color: var(--v24-muted);
    font-size: 12px;
}

.v24-smh-ai-card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

.v24-smh-ai-card-actions .v24-smh-button {
    padding: 8px 12px;
    font-size: 12px;
}

.v24-smh-ai-card-body {
    padding: 14px 16px;
}

.v24-smh-ai-card-body.is-ignored {
    background: linear-gradient(135deg, rgba(61, 217, 255, 0.08), rgba(140, 99, 255, 0.08));
    color: var(--v24-text-soft);
}

.v24-smh-ai-response-html {
    min-height: 180px;
    padding: 14px 16px;
}

.v24-smh-ai-stars {
    display: flex;
    gap: 8px;
}

.v24-smh-ai-star {
    min-width: 30px;
    height: 30px;
    border-radius: 999px;
    border: 1px solid rgba(121, 148, 210, 0.22);
    background: rgba(10, 18, 36, 0.86);
    color: #ffffff;
    cursor: pointer;
}

.v24-smh-ai-star.is-active {
    border-color: rgba(79, 227, 154, 0.4);
    background: rgba(79, 227, 154, 0.16);
    color: #9ff4c7;
}

.v24-smh-ai-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    color: var(--v24-muted);
    font-size: 12px;
}

.v24-smh-ai-preview,
.v24-smh-ai-audio {
    display: grid;
    gap: 10px;
    padding: 14px;
    border-radius: 18px;
    border: 1px dashed rgba(61, 217, 255, 0.28);
    background: rgba(5, 12, 27, 0.72);
}

.v24-smh-ai-preview-body {
    max-height: 320px;
    overflow: auto;
    color: var(--v24-text-soft);
}

.v24-smh-ai-audio audio {
    width: 100%;
    filter: hue-rotate(165deg) saturate(1.1);
}

@media (max-width: 1260px) {
    .v24-smh-compose-layout {
        grid-template-columns: 1fr;
    }

    .v24-smh-compose-main {
        border-right: 0;
        border-bottom: 1px solid rgba(121, 148, 210, 0.18);
    }
}

@media (max-width: 760px) {
    .v24-smh-compose-main,
    .v24-smh-ai-dock {
        padding: 16px;
    }

    .v24-smh-ai-section-head,
    .v24-smh-ai-card-head,
    .v24-smh-ai-card-foot {
        flex-direction: column;
        align-items: stretch;
    }
}

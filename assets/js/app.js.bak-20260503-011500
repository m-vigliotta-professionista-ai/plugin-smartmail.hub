    function recurrenceSummary(recurrence) {
        if (!recurrence || !recurrence.frequency || recurrence.frequency === 'none') {
            return 'Evento singolo';
        }

        const every = Number(recurrence.interval || 1);
        const base = {
            daily: `Ogni ${every} giorno${every > 1 ? 'i' : ''}`,
            weekly: `Ogni ${every} settimana${every > 1 ? 'e' : ''}`,
            monthly: `Ogni ${every} mese${every > 1 ? 'i' : ''}`,
            yearly: `Ogni ${every} anno${every > 1 ? 'i' : ''}`
        }[recurrence.frequency] || 'Ricorrenza personalizzata';

        const details = [];
        if (recurrence.weekdays && recurrence.weekdays.length) {
            details.push(recurrence.weekdays.join(', '));
        }
        if (recurrence.months && recurrence.months.length) {
            details.push(`mesi ${recurrence.months.join(', ')}`);
        }
        if (recurrence.until) {
            details.push(`fino al ${formatDisplayDate(recurrence.until)}`);
        } else if (recurrence.count) {
            details.push(`${recurrence.count} occorrenze`);
        }

        return [base, details.join(' | ')].filter(Boolean).join(' - ');
    }


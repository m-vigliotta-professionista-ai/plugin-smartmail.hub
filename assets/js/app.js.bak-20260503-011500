                    <button type="${config.kind === 'text' || config.kind === 'select' ? 'submit' : 'button'}" class="${config.danger ? 'v24-smh-button v24-smh-folder-dialog-danger' : 'v24-smh-button-primary'}" data-folder-dialog-confirm>${escapeHtml(config.confirmLabel || 'Conferma')}</button>

    function openContactForm(contact) {
        state.editingContactId = contact ? contact.id : null;
        region('contact-form-title').textContent = contact ? 'Modifica contatto' : 'Nuovo contatto';

        contactField('display-name').value = contact ? contact.display_name || '' : '';
        contactField('first-name').value = contact ? contact.first_name || '' : '';
        contactField('last-name').value = contact ? contact.last_name || '' : '';
        contactField('company').value = contact ? contact.company || '' : '';
        contactField('department').value = contact ? contact.department || '' : '';
        contactField('job-title').value = contact ? contact.job_title || '' : '';
        contactField('primary-email').value = contact ? contact.primary_email || '' : '';
        contactField('mobile-phone').value = contact ? contact.mobile_phone || '' : '';
        contactField('business-phone').value = contact ? contact.business_phone || '' : '';
        contactField('website-url').value = contact ? contact.website_url || '' : '';
        contactField('emails').value = contact ? safeJson(contact.emails_json).filter((email) => email !== contact.primary_email).join(', ') : '';
        contactField('phones').value = contact ? safeJson(contact.phones_json).filter((phone) => phone !== contact.mobile_phone && phone !== contact.business_phone).join(', ') : '';
        contactField('addresses').value = contact ? safeJson(contact.addresses_json).join(', ') : '';
        contactField('categories').value = contact ? safeJson(contact.categories_json).join(', ') : '';
        contactField('notes').value = contact ? contact.notes || '' : '';

        showContactFormPanel();
    }

    function closeContactForm() {
        showContactReaderPanel();
        if (state.currentContact) {
            renderContact(state.currentContact);
        } else {
            renderContactEmptyState('Seleziona una scheda dalla colonna centrale o crea un nuovo contatto.');
        }
    }

    async function submitContact(event) {
        event.preventDefault();
        const payload = {
            display_name: contactField('display-name').value,
            first_name: contactField('first-name').value,
            last_name: contactField('last-name').value,
            company: contactField('company').value,
            department: contactField('department').value,
            job_title: contactField('job-title').value,
            primary_email: contactField('primary-email').value,
            mobile_phone: contactField('mobile-phone').value,
            business_phone: contactField('business-phone').value,
            website_url: contactField('website-url').value,
            emails: splitCsv(contactField('emails').value),
            phones: splitCsv(contactField('phones').value),
            addresses: splitCsv(contactField('addresses').value),
            categories: splitCsv(contactField('categories').value),
            notes: contactField('notes').value
        };

        let result;
        if (state.editingContactId) {
            result = await api(`/contacts/${state.editingContactId}`, {
                method: 'PUT',
                body: JSON.stringify(payload)
            });
        } else {
            result = await api('/contacts', {
                method: 'POST',
                body: JSON.stringify(payload)
            });
        }

        closeContactForm();
        await loadContacts();
        if (result.data && result.data.id) {
            await openContact(result.data.id);
        }
        setStatus('Contatto salvato.');
    }

    async function deleteCurrentContact() {
        if (!state.currentContact || !window.confirm('Eliminare questo contatto?')) {
            return;
        }

        await api(`/contacts/${state.currentContact.id}`, { method: 'DELETE' });
        state.currentContact = null;
        closeContactForm();
        renderContactEmptyState('Il contatto e stato eliminato. Selezionane un altro oppure crea una nuova scheda.', 'Contatto eliminato');
        await loadContacts();
        setStatus('Contatto eliminato.');
    }

    async function loadWorkspaceUsers() {
        if (state.users.length) {
            return state.users;
        }

        const result = await api('/calendar/users');
        state.users = result.data || [];
        populateTaskUsers();
        renderCalendarShareOptions(state.currentCalendar);
        return state.users;
    }

    function ensureCalendarRange() {
        if (!state.calendarCursor) {
            state.calendarCursor = formatDateOnly(new Date());
        }

        syncCalendarRangeFields();
        updateCalendarViewButtons();
        updateCalendarPeriod();
        renderMiniMonth();
    }

    function eventRangeParams() {
        ensureCalendarRange();
        syncCalendarRangeFields();
        return {
            start: `${region('calendar-start').value} 00:00:00`,
            end: `${region('calendar-end').value} 23:59:59`
        };
    }

    async function loadCalendars() {
        const result = await api('/calendar/calendars');
        state.calendars = result.data || [];

        if (state.selectedCalendarId && !state.calendars.some((calendar) => Number(calendar.id) === Number(state.selectedCalendarId))) {
            state.selectedCalendarId = null;
        }

        if (!state.selectedCalendarId && state.calendars[0]) {
            state.currentCalendar = state.calendars[0];
        } else {
            state.currentCalendar = state.calendars.find((calendar) => Number(calendar.id) === Number(state.selectedCalendarId)) || null;
        }

        renderCalendars();
        populateEventCalendars();
        renderMiniMonth();
        return state.calendars;
    }

    function renderCalendars() {
        const target = region('calendar-list');
        target.innerHTML = '';
        const calendars = filteredCalendars();

        const allButton = createButton('Tutti i calendari', 'v24-smh-list-button');
        allButton.classList.toggle('is-active', !state.selectedCalendarId);
        allButton.addEventListener('click', () => {
            state.selectedCalendarId = null;
            state.currentCalendar = null;
            renderCalendars();
            loadEvents().catch((error) => setStatus(error.message || 'Caricamento eventi non riuscito.'));
        });
        target.appendChild(allButton);

        calendars.forEach((calendar) => {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = `v24-smh-list-button${Number(calendar.id) === Number(state.selectedCalendarId) ? ' is-active' : ''}`;
            button.setAttribute('data-calendar-id', calendar.id);
            button.innerHTML = `
                <span class="v24-smh-color-chip" style="--chip:${escapeHtml(calendar.color || '#0d5c63')}"></span>
                <strong>${escapeHtml(calendar.name || '')}</strong>
                <small>${escapeHtml(calendar.permission_level || '')}</small>
            `;
            button.addEventListener('click', () => {
                state.selectedCalendarId = calendar.id;
                state.currentCalendar = calendar;
                renderCalendars();
                loadEvents().catch((error) => setStatus(error.message || 'Caricamento eventi non riuscito.'));
            });
            target.appendChild(button);
        });

        if (!calendars.length) {
            const empty = document.createElement('p');
            empty.textContent = 'Nessun calendario corrisponde al filtro.';
            target.appendChild(empty);
        }

        renderCalendarManager();
        renderMiniMonth();
    }

    function renderCalendarManager() {
        const target = region('calendar-manager');
        const calendar = state.currentCalendar;
        if (!calendar) {
            target.innerHTML = '<p>Visualizzazione completa dei calendari disponibili.</p>';
            return;
        }

        target.innerHTML = `
            <div class="v24-smh-card">
                <div class="v24-smh-card-header">
                    <div>
                        <h3>${escapeHtml(calendar.name || '')}</h3>
                        <p>${escapeHtml(calendar.owner_name || '')}</p>
                    </div>
                    <span class="v24-smh-color-badge" style="background:${escapeHtml(calendar.color || '#0d5c63')}"></span>
                </div>
                <p>${escapeHtml(calendar.description || 'Nessuna descrizione.')}</p>
                <p><strong>Permesso:</strong> ${escapeHtml(calendar.permission_level || 'read')}</p>
                <div class="v24-smh-reader-actions">
                    ${calendar.can_edit ? '<button type="button" data-action="new-event-on-calendar">Nuovo evento</button>' : ''}
                    ${calendar.can_manage_shares ? '<button type="button" data-action="edit-calendar">Modifica calendario</button>' : ''}
                    ${calendar.can_manage_shares && !Number(calendar.is_default) ? '<button type="button" data-action="delete-calendar">Elimina calendario</button>' : ''}
                </div>
                <div>
                    <h4>Condivisioni</h4>
                    ${renderTagList((calendar.shares || []).map((share) => `${share.display_name}: ${share.permission_level}`), 'Nessuna condivisione attiva.')}
                </div>
            </div>
        `;
    }

    function populateEventCalendars(selectedId) {
        const target = eventField('calendar');
        target.innerHTML = '';
        state.calendars.filter((calendar) => calendar.can_edit).forEach((calendar) => {
            target.appendChild(createOption(calendar.id, calendar.name, Number(calendar.id) === Number(selectedId || selectedEditableCalendarId())));
        });
    }

    function renderCalendarShareOptions(calendar) {
        const target = region('calendar-share-options');
        target.innerHTML = '';

        if (!state.users.length) {
            target.innerHTML = '<p>Nessun utente disponibile.</p>';
            return;
        }

        const selectedMap = {};
        (calendar && calendar.shares ? calendar.shares : []).forEach((share) => {
            selectedMap[share.user_id] = share.permission_level;
        });

        state.users.filter((user) => Number(user.id) !== currentUserId).forEach((user) => {
            const wrapper = document.createElement('label');
            wrapper.className = 'v24-smh-share-row';
            wrapper.innerHTML = `
                <span>${escapeHtml(user.display_name || user.email || `Utente ${user.id}`)}</span>
                <select data-share-user="${user.id}">
                    <option value="">Nessun accesso</option>
                    <option value="read"${selectedMap[user.id] === 'read' ? ' selected' : ''}>Lettura</option>
                    <option value="edit"${selectedMap[user.id] === 'edit' ? ' selected' : ''}>Modifica</option>
                </select>
            `;
            target.appendChild(wrapper);
        });
    }

    function collectCalendarShares() {
        const shares = [];
        region('calendar-share-options').querySelectorAll('[data-share-user]').forEach((select) => {
            if (!select.value) {
                return;
            }

            shares.push({
                user_id: Number(select.getAttribute('data-share-user')),
                permission_level: select.value
            });
        });
        return shares;
    }

    function renderCalendarEventChip(calendarEvent, options = {}) {
        const key = calendarEventKey(calendarEvent);
        const start = parseDateTimeValue(calendarEvent.start_at);
        const timeLabel = Number(calendarEvent.is_all_day || 0)
            ? 'Tutto il giorno'
            : `${pad2(start.getHours())}:${pad2(start.getMinutes())}`;
        const classNames = [
            'v24-smh-calendar-event-chip',
            options.compact ? 'is-compact' : '',
            state.currentEvent && calendarEventKey(state.currentEvent) === key ? 'is-active' : ''
        ].filter(Boolean).join(' ');

        return `
            <button
                type="button"
                class="${classNames}"
                data-action="open-calendar-event"
                data-event-key="${key}"
                style="--event-color:${calendarEventColor(calendarEvent)}"
            >
                <span class="v24-smh-calendar-event-time">${escapeHtml(timeLabel)}</span>
                <strong>${escapeHtml(calendarEvent.title || 'Evento')}</strong>
            </button>
        `;
    }

    function calendarEventTouchesDate(calendarEvent, date) {
        const start = parseDateTimeValue(calendarEvent.start_at);
        const end = parseDateTimeValue(calendarEvent.end_at || calendarEvent.start_at);
        const dayStart = new Date(date.getFullYear(), date.getMonth(), date.getDate(), 0, 0, 0, 0);
        const dayEnd = new Date(date.getFullYear(), date.getMonth(), date.getDate(), 23, 59, 59, 999);
        return start <= dayEnd && end >= dayStart;
    }

    function renderCalendarAgendaView(events) {
        const gridTarget = region('calendar-grid');
        const agendaTarget = region('events');

        gridTarget.hidden = true;
        agendaTarget.hidden = false;

        if (!events.length) {
            agendaTarget.innerHTML = '<div class="v24-smh-calendar-empty">Nessun evento nel periodo selezionato.</div>';
            return;
        }

        agendaTarget.innerHTML = events.map((calendarEvent) => {
            const meta = [
                calendarEvent.calendar_name,
                calendarEvent.location,
                calendarEvent.is_occurrence ? 'Ricorrente' : ''
            ].filter(Boolean).join(' | ');

            return `
                <button type="button" class="v24-smh-record v24-smh-calendar-agenda-item${state.currentEvent && calendarEventKey(state.currentEvent) === calendarEventKey(calendarEvent) ? ' is-active' : ''}" data-action="open-calendar-event" data-event-key="${calendarEventKey(calendarEvent)}">
                    <strong>${escapeHtml(calendarEvent.title || '')}</strong>
                    <span>${escapeHtml(formatDisplayDate(calendarEvent.start_at))}</span>
                    <small>${escapeHtml(meta)}</small>
                </button>
            `;
        }).join('');
    }

    function renderCalendarTimeGridView(events) {
        const gridTarget = region('calendar-grid');
        const agendaTarget = region('events');
        const range = currentCalendarRange();
        const days = calendarDateRange(range.startDate, range.endDate);
        const hours = Array.from({ length: 24 }, (_, index) => index);
        const today = parseDateOnly(formatDateOnly(new Date()));

        const allDayByDate = {};
        const timedByCell = {};

        days.forEach((date) => {
            allDayByDate[formatDateOnly(date)] = [];
        });

        events.forEach((calendarEvent) => {
            const start = parseDateTimeValue(calendarEvent.start_at);
            const dateKey = formatDateOnly(start);
            if (Number(calendarEvent.is_all_day || 0)) {
                days.forEach((date) => {
                    if (calendarEventTouchesDate(calendarEvent, date)) {
                        allDayByDate[formatDateOnly(date)].push(calendarEvent);
                    }
                });
                return;
            }

            const cellKey = `${dateKey}-${start.getHours()}`;
            if (!timedByCell[cellKey]) {
                timedByCell[cellKey] = [];
            }
            timedByCell[cellKey].push(calendarEvent);
        });

        gridTarget.hidden = false;
        agendaTarget.hidden = true;
        gridTarget.innerHTML = `
            <div class="v24-smh-calendar-grid-week">
                <div class="v24-smh-calendar-grid-head" style="grid-template-columns: 76px repeat(${days.length}, minmax(140px, 1fr));">
                    <div class="v24-smh-calendar-axis-spacer"></div>
                    ${days.map((date) => `
                        <button type="button" class="v24-smh-calendar-day-head${sameDay(date, today) ? ' is-today' : ''}" data-action="calendar-mini-day" data-date="${formatDateOnly(date)}">
                            <strong>${escapeHtml(formatCalendarDayLabel(date))}</strong>
                            <span>${escapeHtml(date.toLocaleDateString('it-IT', { day: 'numeric', month: 'short' }))}</span>
                        </button>
                    `).join('')}
                </div>
                <div class="v24-smh-calendar-all-day-row" style="grid-template-columns: 76px repeat(${days.length}, minmax(140px, 1fr));">
                    <div class="v24-smh-calendar-axis-label">Tutto il giorno</div>
                    ${days.map((date) => `
                        <div class="v24-smh-calendar-all-day-cell">
                            ${(allDayByDate[formatDateOnly(date)] || []).map((calendarEvent) => renderCalendarEventChip(calendarEvent, { compact: true })).join('')}
                        </div>
                    `).join('')}
                </div>
                <div class="v24-smh-calendar-time-grid" style="grid-template-columns: 76px repeat(${days.length}, minmax(140px, 1fr));">
                    ${hours.map((hour) => `
                        <div class="v24-smh-calendar-time-label">${calendarHourLabel(hour)}</div>
                        ${days.map((date) => {
                            const dateKey = formatDateOnly(date);
                            const slotEvents = timedByCell[`${dateKey}-${hour}`] || [];
                            return `
                                <div class="v24-smh-calendar-slot${sameDay(date, today) ? ' is-today' : ''}" data-action="new-event-slot" data-date="${dateKey}" data-hour="${hour}">
                                    ${slotEvents.map((calendarEvent) => renderCalendarEventChip(calendarEvent, { compact: true })).join('')}
                                </div>
                            `;
                        }).join('')}
                    `).join('')}
                </div>
            </div>
        `;
    }

    function renderCalendarMonthView(events) {
        const gridTarget = region('calendar-grid');
        const agendaTarget = region('events');
        const current = calendarCurrentDate();
        const gridStart = startOfMonthGrid(current);
        const gridEnd = endOfMonthGrid(current);
        const days = calendarDateRange(gridStart, gridEnd);
        const today = parseDateOnly(formatDateOnly(new Date()));

        gridTarget.hidden = false;
        agendaTarget.hidden = true;
        gridTarget.innerHTML = `
            <div class="v24-smh-calendar-grid-month">
                <div class="v24-smh-calendar-month-weekdays">
                    <span>Lunedì</span>
                    <span>Martedì</span>
                    <span>Mercoledì</span>
                    <span>Giovedì</span>
                    <span>Venerdì</span>
                    <span>Sabato</span>
                    <span>Domenica</span>
                </div>
                <div class="v24-smh-calendar-month-grid">
                    ${days.map((date) => {
                        const dayEvents = events.filter((calendarEvent) => calendarEventTouchesDate(calendarEvent, date)).slice(0, 4);
                        const hiddenCount = Math.max(events.filter((calendarEvent) => calendarEventTouchesDate(calendarEvent, date)).length - dayEvents.length, 0);
                        return `
                            <div class="v24-smh-calendar-month-day${date.getMonth() !== current.getMonth() ? ' is-outside' : ''}${sameDay(date, today) ? ' is-today' : ''}">
                                <button type="button" class="v24-smh-calendar-month-day-number" data-action="calendar-mini-day" data-date="${formatDateOnly(date)}">${date.getDate()}</button>
                                <div class="v24-smh-calendar-month-events">
                                    ${dayEvents.map((calendarEvent) => renderCalendarEventChip(calendarEvent, { compact: true })).join('')}
                                    ${hiddenCount ? `<span class="v24-smh-calendar-more">+${hiddenCount} altri</span>` : ''}
                                </div>
                            </div>
                        `;
                    }).join('')}
                </div>
            </div>
        `;
    }

    function renderCalendarBoard() {
        ensureCalendarRange();
        updateCalendarPeriod();
        renderMiniMonth();

        const events = filteredCalendarEvents().sort((first, second) => {
            const firstDate = parseDateTimeValue(first.start_at).getTime();
            const secondDate = parseDateTimeValue(second.start_at).getTime();
            return firstDate - secondDate;
        });

        if (state.calendarView === 'agenda') {
            renderCalendarAgendaView(events);
            return;
        }

        if (state.calendarView === 'month') {
            renderCalendarMonthView(events);
            return;
        }

        renderCalendarTimeGridView(events);
    }

    function calendarNavigate(direction) {
        const current = calendarCurrentDate();
        let nextDate = current;

        if (direction === 'today') {
            nextDate = parseDateOnly(formatDateOnly(new Date()));
        } else if (state.calendarView === 'month') {
            nextDate = new Date(current.getFullYear(), current.getMonth() + direction, 1);
        } else if (state.calendarView === 'day') {
            nextDate = addDays(current, direction);
        } else if (state.calendarView === 'agenda') {
            nextDate = addDays(current, direction * 7);
        } else {
            nextDate = addDays(current, direction * 7);
        }

        state.calendarCursor = formatDateOnly(nextDate);
    }

    function openEventByKey(eventKey) {
        const found = state.calendarEvents.find((calendarEvent) => calendarEventKey(calendarEvent) === String(eventKey));
        if (found) {
            return openEvent(found);
        }

        setStatus('Evento non disponibile nel range corrente.');
        return Promise.resolve();
    }

    async function loadEvents() {
        const range = eventRangeParams();
        const params = new URLSearchParams({
            start: range.start,
            end: range.end
        });
        if (state.selectedCalendarId) {
            params.set('calendar_ids', state.selectedCalendarId);
        }

        const result = await api(`/calendar/events?${params.toString()}`);
        state.calendarEvents = result.data || [];
        renderCalendarBoard();

        if (!state.calendarEvents.length) {
            setStatus('Nessun evento.');
            return;
        }

        setStatus(`${state.calendarEvents.length} eventi caricati.`);
    }

    async function openEvent(eventOrId) {
        let calendarEvent = eventOrId;

        if (typeof eventOrId === 'number') {
            const result = await api(`/calendar/events/${eventOrId}`);
            calendarEvent = result.data;
        }

        state.currentEvent = calendarEvent;
        state.currentCalendar = state.calendars.find((calendar) => Number(calendar.id) === Number(calendarEvent.calendar_id)) || state.currentCalendar;
        highlightCalendarEventSelection(calendarEventKey(calendarEvent));
        renderCalendarManager();
        renderEvent(calendarEvent);
        setStatus('Evento aperto.');
    }


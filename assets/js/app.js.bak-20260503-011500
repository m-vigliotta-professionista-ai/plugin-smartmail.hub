        eventField('recurrence-month-day').value = recurrence.month_day || 1;
        eventField('recurrence-nth-week').value = recurrence.nth_week || 1;
        eventField('recurrence-nth-weekday').value = recurrence.nth_weekday || 'MO';
        eventField('recurrence-months').value = (recurrence.months || []).join(',');
        eventField('recurrence-until').value = recurrence.until ? formatDateTime(recurrence.until) : '';
        eventField('recurrence-count').value = recurrence.count || '';

        region('event-form-sheet').hidden = false;

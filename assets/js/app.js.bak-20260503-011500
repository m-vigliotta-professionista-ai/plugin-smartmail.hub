            `Tipo speciale: ${folder.special_use || 'standard'}`,
            `Messaggi: ${Number(folder.message_count || 0)}`,
            `Non letti: ${Number(folder.unseen_count || 0)}`
        ];
        await openFolderInfoDialog({
            title: 'Proprieta cartella',
            description: folderDisplayName(folder),
            lines
        });
    }

    async function handleFolderMenuAction(action) {
        const folder = folderById(state.folderContextId);
        closeFolderContextMenu();

        if (!folder) {
            return;
        }

        if (action === 'open-window') {
            window.open(folderUrl(folder), '_blank', 'noopener');
            setStatus('Cartella aperta in una nuova finestra.');
        } else if (action === 'new-folder') {
            await createFolderFromContext(folder);
        } else if (action === 'rename-folder') {
            await renameFolderFromContext(folder);
        } else if (action === 'copy-folder') {
            await copyFolderFromContext(folder);
        } else if (action === 'move-folder') {
            await moveFolderFromContext(folder);
        } else if (action === 'delete-folder') {
            await deleteFolderFromContext(folder);
        } else if (action === 'mark-read-folder') {
            await markFolderReadFromContext(folder);
        } else if (action === 'empty-folder') {
            await emptyFolderFromContext(folder);
        } else if (action === 'purge-folder') {
            await purgeFolderFromContext(folder);
        } else if (action === 'sync-imap-folders') {
            await sync();
        } else if (action === 'toggle-favorite-folder') {
            toggleFavoriteFolder(folder);
        } else if (action === 'sort-folder-az') {
            sortFolderChildrenAlphabetically(folder);
        } else if (action === 'folder-move-up') {
            if (moveFolderOrder(folder.id, -1)) {
                setStatus('Cartella spostata verso l alto.');
            }
        } else if (action === 'folder-move-down') {
            if (moveFolderOrder(folder.id, 1)) {
                setStatus('Cartella spostata verso il basso.');
            }
        } else if (action === 'folder-properties') {
            await showFolderProperties(folder);
        }
    }


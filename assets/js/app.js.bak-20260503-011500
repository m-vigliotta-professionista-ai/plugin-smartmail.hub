    function renderContactGroups() {
        const target = region('contact-groups');
        if (!target) {
            return;
        }

        const groups = buildContactGroupCatalog(state.contacts);
        if (!groups.some((group) => group.key === state.contactGroup)) {
            state.contactGroup = 'all';
        }

        const query = String(region('contact-groups-search')?.value || '').trim().toLowerCase();
        const filteredGroups = query
            ? groups.filter((group) => (
                group.label.toLowerCase().includes(query)
                || group.section.toLowerCase().includes(query)
                || String(group.hint || '').toLowerCase().includes(query)
            ))
            : groups;

        if (!filteredGroups.length) {
            target.innerHTML = '<p>Nessun gruppo trovato.</p>';
            return;
        }

        const sections = filteredGroups.reduce((collection, group) => {
            if (!collection.has(group.section)) {
                collection.set(group.section, []);
            }
            collection.get(group.section).push(group);
            return collection;
        }, new Map());

        target.innerHTML = Array.from(sections.entries()).map(([section, sectionGroups]) => `
            <section class="v24-smh-contact-group-section">
                <h3>${escapeHtml(section)}</h3>
                ${sectionGroups.map((group) => `
                    <button
                        type="button"
                        class="v24-smh-contact-group${group.key === state.contactGroup ? ' is-active' : ''}"
                        data-action="select-contact-group"
                        data-group-key="${escapeHtml(group.key)}"

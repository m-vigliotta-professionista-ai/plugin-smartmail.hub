    async function deleteFolderFromContext(folder) {
        const confirmed = await openFolderConfirmDialog({
            title: 'Elimina cartella',
            description: `Vuoi eliminare ${folderDisplayName(folder)}?`,
            confirmLabel: 'Elimina',
            cancelLabel: 'Annulla',
            danger: true
        });
        if (!confirmed) {
            return;
        }

        const wasSelected = Number(state.folderId) === Number(folder.id);
        setStatus('Eliminazione cartella...');
        const result = await api(`/mail/folders/${folder.id}/delete`, {
            method: 'POST',
            body: '{}'
        });

        state.folders = result.data && result.data.folders ? result.data.folders : state.folders.filter((item) => Number(item.id) !== Number(folder.id));
        renderFolders();

        if (wasSelected) {
            const fallbackFolder = resolvePreferredFolder(state.folders);
            if (fallbackFolder) {
                await selectFolder(fallbackFolder.id);
            } else {
                state.folderId = null;
                state.currentMessage = null;
                syncFolderRoute();
                updateMailListHeader(0);
                region('messages').innerHTML = '<p>Nessuna cartella sincronizzata.</p>';
                region('reader').innerHTML = '<p>Avvia una sincronizzazione per popolare le cartelle.</p>';
            }
        }

        setStatus('Cartella eliminata.');
    }


    function resolveFolderDialog(value) {
        const { backdrop, sheet } = ensureFolderDialog();
        const resolver = folderDialogState.resolver;
        folderDialogState.resolver = null;
        backdrop.hidden = true;
        sheet.hidden = true;
        sheet.innerHTML = '';
        if (resolver) {
            resolver(value);
        }
    }

    function openFolderDialog(config) {
